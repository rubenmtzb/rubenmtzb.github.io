---
import { TECH } from '../../lib/tech'
import { homePath } from '../../lib/content'
import { t, type Lang } from '../../i18n/ui'
import { canonicalTerm, localizedTerm } from '../../i18n/terms'

/**
 * Chip de tecnología: logotipo, color de marca y enlace a la página oficial.
 * Única fuente del patrón, así que la misma tecnología se ve igual en el hero,
 * en los proyectos, en la experiencia, en la formación y en las certificaciones.
 * Si la etiqueta no está en TECH cae a una píldora neutra sin enlace.
 */
interface Props { tag: string; lang: Lang; class?: string }
const { tag, lang, class: extra = 'project-tech-chip' } = Astro.props

/* El registro indexa por la forma canónica; el contenido castellano escribe la
   etiqueta ya traducida. Se busca por la primera y se muestra la segunda. */
const meta = TECH[canonicalTerm(tag)]
const home = homePath(lang)
const displayTag = localizedTerm(tag, lang)

/*
 * Las chips de concepto apuntan a una sección de la portada. El enlace es
 * absoluto y con idioma para que también funcione desde las fichas de
 * proyecto, donde esa sección no existe: un "#education" suelto no llevaba
 * a ninguna parte fuera de la home.
 */
const href = meta?.anchor ? `${home}#${meta.anchor}` : meta?.url
const isInternal = Boolean(meta?.anchor)

const label = isInternal
  ? `${displayTag} — ${t(lang, 'v2.chip.viewEducation')}`
  : `${displayTag} — ${t(lang, 'v2.chip.officialSite')}`
---

{meta && href ? (
  <a
    href={href}
    target={isInternal ? undefined : '_blank'}
    rel={isInternal ? undefined : 'noopener noreferrer'}
    class={`hero-tech-chip ${extra}`}
    style={`--chip-color: ${meta.color}; --chip-glow: ${meta.glow};`}
    aria-label={label}
  >
    {meta.icon && <img src={meta.icon} alt="" width="12" height="12" loading="lazy" decoding="async" />}
    <span>{displayTag}</span>
  </a>
) : (
  <span
    class={`hero-tech-chip ${extra} project-tech-label`}
    style="--chip-color: var(--cyan); --chip-glow: rgba(111, 227, 255, 0.2);"
  >
    <span class="project-tech-marker" aria-hidden="true"></span>
    <span>{displayTag}</span>
  </span>
)}
