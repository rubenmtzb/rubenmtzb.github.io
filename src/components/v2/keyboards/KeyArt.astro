---
/**
 * A novelty's engraving. These are the six illustrations printed on the sets'
 * special keycaps; every other key carries text and never comes through here.
 */
import type { KeyArtwork } from '../../../lib/keyboard-layouts'

interface Props { artwork: KeyArtwork }
const { artwork } = Astro.props
---

<svg class="bx-key-art" viewBox="0 0 32 20" aria-hidden="true">
{artwork === 'spade' && (
  <path class="is-fill" d="M16 1.5C13.7 5.4 7.2 7.8 7.2 12.7c0 2.9 2.2 4.8 4.8 4.8 1.3 0 2.4-.4 3.1-1.2-.2 1.2-.8 2-2.2 2.7h6.2c-1.4-.7-2-1.5-2.2-2.7.7.8 1.8 1.2 3.1 1.2 2.6 0 4.8-1.9 4.8-4.8 0-4.9-6.5-7.3-8.8-11.2Z" />
)}
{artwork === 'planet' && (
  <>
    <circle class="is-fill" cx="16" cy="10" r="5.2" />
    <ellipse cx="16" cy="10" rx="12.5" ry="4.2" transform="rotate(-13 16 10)" />
    <circle class="is-cutout" cx="14.2" cy="8.3" r="1.1" />
  </>
)}
{artwork === 'rocket' && (
  <>
    <path d="M6 15.8c4.8-1 8-3.4 10.2-8.1 1.2-2.5 3.6-4.4 7.7-5.5-.8 4.2-2.4 6.8-4.7 8.2-4.3 2.7-7.4 3.1-13.2 5.4Z" />
    <path d="m11 13-3.8-.8 2.7-2.1M16.9 8.5l2.5 3.1-3.3.7" />
    <circle class="is-fill" cx="19.7" cy="6.1" r="1.25" />
    <path d="m8.8 15.1-3 2.2m5.7-3-2.3 3.2" />
  </>
)}
{artwork === 'comet' && (
  <>
    <path d="M3 16.4C9.5 16 13.2 13.6 17 8.2M5.4 18c6.1-1.2 10.2-3.4 13.4-7.8" />
    <path class="is-fill" d="m21.6 2.1 1.5 3 3.4.5-2.5 2.3.6 3.3-3-1.6-3 1.6.6-3.3-2.5-2.3 3.4-.5 1.5-3Z" />
  </>
)}
{artwork === 'constellation' && (
  <>
    <path d="m5 14 7-8 6 5 8-7M12 6l2 10 4-5" />
    <circle class="is-fill" cx="5" cy="14" r="1.7" />
    <circle class="is-fill" cx="12" cy="6" r="1.5" />
    <circle class="is-fill" cx="14" cy="16" r="1.3" />
    <circle class="is-fill" cx="18" cy="11" r="1.6" />
    <circle class="is-fill" cx="26" cy="4" r="1.8" />
  </>
)}
{artwork === 'eclipse' && (
  <>
    <path class="is-fill" d="M18.4 3.1a7 7 0 1 0 0 13.8A5.7 5.7 0 1 1 18.4 3Z" />
    <path d="m23.7 3.2.7 1.5 1.7.2-1.2 1.2.3 1.7-1.5-.8-1.6.8.3-1.7-1.2-1.2 1.6-.2.8-1.5Z" />
  </>
)}
</svg>
