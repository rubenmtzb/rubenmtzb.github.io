---
/**
 * Portada de un build en la galería.
 *
 * La tarjeta entera es el objetivo —foto, título y botón abren el mismo
 * build—, salvo los mandos del carrusel, que pasan de foto sin salir de la
 * galería. Quién es quién lo decide el explorador leyendo `data-bx-open`.
 *
 * Las fotografías se descargan todas desde el principio y no al mostrarse: el
 * carrusel se pasa con las flechas, y una imagen que empieza a bajar en el
 * momento en que se pide llega tarde, se ve el hueco. Como el bloque vive
 * detrás de una pestaña y muy por debajo del pliegue, la descarga va con
 * `fetchpriority="low"`, así que ocurre con la conexión ya libre y no le quita
 * ancho de banda a lo que se está mirando.
 */
import { Picture } from 'astro:assets'
import { buildDisplayStatus, localizer, type KeyboardBuild } from '../../../lib/content'
import { keyboardCopy } from '../../../i18n/keyboards'
import type { Lang } from '../../../i18n/ui'

interface Props { build: KeyboardBuild; index: number; lang: Lang }
const { build, index, lang } = Astro.props
const pick = localizer(lang)
const copy = keyboardCopy(lang)

/** Con una sola fotografía no hay nada que pasar: ni flechas, ni puntos, ni contador. */
const hasCarousel = build.photos.length > 1

/**
 * Cortes de la portada fotográfica.
 *
 * La tarjeta nunca pasa de ~500 px de ancho —dos columnas dentro del panel,
 * una sola por debajo de 34rem— así que la escalera cubre hasta densidad 3x
 * y ahí se detiene: pedir el original de 1490 px para una tarjeta de 340 px
 * era gastar un megabyte en píxeles que la pantalla no puede enseñar.
 */
const PHOTO_WIDTHS = [420, 680, 1020, 1360]

/** Nunca pide al pipeline un corte mayor que el original de cada fotografía. */
const photoWidths = (intrinsic: number) => {
  const fitting = PHOTO_WIDTHS.filter((width) => width <= intrinsic)
  return fitting.length > 0 ? fitting : [intrinsic]
}

/**
 * El corte mayor que se llega a servir, que es también el `src` de respaldo.
 * Declarar aquí el original obligaba al pipeline a generar un corte extra a
 * tamaño completo que ninguna pantalla pedía: mismo aspecto, un fichero menos.
 */
const photoWidth = (intrinsic: number) => photoWidths(intrinsic).at(-1) ?? intrinsic
---

<li>
  <article class={`bx-build-card is-${buildDisplayStatus(build)}`} data-bx-open={build.key}>
    <div
      class="bx-card-visual"
      data-bx-card-carousel
      tabindex="0"
      role="region"
      aria-roledescription="carousel"
      aria-label={`${copy.cover}: ${build.name}`}
    >
      {build.photos.map((photo, photoIndex) => (
        <figure
          class="bx-card-slide"
          data-bx-card-slide={photoIndex}
          data-bx-card-label={pick(photo.label)}
          aria-hidden={photoIndex === 0 ? 'false' : 'true'}
          hidden={photoIndex !== 0}
        >
          <Picture
            src={photo.image}
            formats={['avif']}
            fallbackFormat="webp"
            widths={photoWidths(photo.image.width)}
            width={photoWidth(photo.image.width)}
            quality={82}
            sizes="(max-width: 544px) calc(100vw - 4rem), (max-width: 1024px) 44vw, 340px"
            alt={pick(photo.alt)}
            loading="eager"
            fetchpriority="low"
            decoding="async"
            draggable="false"
            class="bx-card-photo"
          />
        </figure>
      ))}
      <span class="bx-card-pointer-light" aria-hidden="true"></span>
      <span class="bx-card-index">BUILD {String(index + 1).padStart(2, '0')}</span>
      <span class="bx-card-authentic"><i></i>{copy.status[buildDisplayStatus(build)]}</span>
      {hasCarousel && (
        <button class="bx-card-nav bx-card-prev" type="button" data-bx-card-prev aria-label={copy.previous}>‹</button>
      )}
      {hasCarousel && (
        <button class="bx-card-nav bx-card-next" type="button" data-bx-card-next aria-label={copy.next}>›</button>
      )}
      <span class="bx-card-photo-meta">
        <span data-bx-card-caption>{pick(build.photos[0].label)}</span>
        {hasCarousel && (
          <b data-bx-card-counter>01 / {String(build.photos.length).padStart(2, '0')}</b>
        )}
      </span>
      {hasCarousel && (
        <span class="bx-card-pagination" role="group" aria-label={`${build.photos.length} ${copy.images}`}>
          {build.photos.map((photo, photoIndex) => (
            <button
              type="button"
              data-bx-card-dot={photoIndex}
              aria-label={`${copy.goTo} ${photoIndex + 1}: ${pick(photo.label)}`}
              aria-current={photoIndex === 0 ? 'true' : 'false'}
            ></button>
          ))}
        </span>
      )}
    </div>
    <div class="bx-card-copy">
      <span class="bx-card-id">
        <strong>{build.name}</strong>
        <small>{pick(build.summary)}</small>
      </span>
      <span class="bx-card-meta">
        <button class="bx-inspect" type="button" data-bx-open={build.key}>
          {build.status === 'complete' ? copy.inspect : copy.openDraft} <b aria-hidden="true">→</b>
        </button>
      </span>
    </div>
  </article>
</li>
