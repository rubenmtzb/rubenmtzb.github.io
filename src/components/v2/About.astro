---
/**
 * Área 02: quién soy, qué he estudiado y qué tengo acreditado.
 *
 * Tres bloques con datos que no se cruzan —el perfil no sabe de títulos y las
 * certificaciones no saben del perfil—, así que cada uno pide su colección y
 * aquí solo queda el orden en que se leen.
 */
import ProfileWorkbench from './about/ProfileWorkbench.astro'
import EducationTimeline from './about/EducationTimeline.astro'
import CertificationSpotlight from './about/CertificationSpotlight.astro'
import { V2_ANCHOR_ALIASES, t, type Lang } from '../../i18n/ui'

interface Props { lang: Lang }
const { lang } = Astro.props
---

<section id="about" class="band border-t border-[color:var(--line-soft)]">
  {(V2_ANCHOR_ALIASES['about'] ?? []).map((a) => <span id={a} class="anchor-alias" aria-hidden="true" />)}

  <div class="shell">
    <header class="rule-head reveal">
      <span class="t-index">02</span>
      <h2 class="t-h2">{t(lang, 'v2.about.title')}</h2>
    </header>

    <ProfileWorkbench lang={lang} />
    <EducationTimeline lang={lang} />
    <CertificationSpotlight lang={lang} />
  </div>
</section>
