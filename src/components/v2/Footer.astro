---
import { getProfile } from '../../lib/content'
import { t, type Lang } from '../../i18n/ui'
interface Props { lang: Lang }
const { lang } = Astro.props
const profile = await getProfile(lang)
const year = new Date().getFullYear()
---
<footer class="border-t border-[color:var(--line-soft)]">
  <div class="shell flex flex-col gap-4 py-10 sm:flex-row sm:items-baseline sm:justify-between">
    <p class="t-meta normal-case tracking-[0.12em]">© {year} {profile.name}</p>
    <p class="t-meta normal-case tracking-[0.12em]">Astro · {lang === 'es' ? 'HTML estático' : 'static HTML'}</p>
    <a href="#identity" class="t-meta normal-case tracking-[0.12em] transition hover:text-[color:var(--blue-bright)]">{t(lang, 'footer.top')}</a>
  </div>
</footer>
