---
import Icon from '../Icon.astro'
import { getCluster } from '../../lib/content'
import { V2_NAV, t, type Lang, type UiKey } from '../../i18n/ui'

interface Props { lang: Lang; pageKey: string }
const { lang, pageKey } = Astro.props
const cluster = await getCluster(pageKey)
const other = cluster.alternates.find((a) => a.lang !== lang)!
---
<!--
  Capa propia por encima de todo. Ningún ancestro lleva transform,
  filter ni contain, que es lo que antes atrapaba la cabecera bajo el
  contenido. El fondo solo aparece al hacer scroll.
-->
<header id="site-header" class="site-header">
  <nav aria-label="Principal" class="shell flex items-center justify-between py-5">
    <a href="#identity" class="text-sm font-bold tracking-[0.34em]">RM</a>

    <div class="hidden items-center gap-9 md:flex">
      {V2_NAV.map((item) => (
        <a href={`#${item.id}`} data-nav={item.id} class="nav-link">{t(lang, item.key as UiKey)}</a>
      ))}
      <a href={other.path} hreflang={other.lang} rel="alternate" class="nav-link" aria-label={t(lang, 'nav.langSwitch')}>
        {t(lang, 'nav.langNext')}
      </a>
    </div>

    <button type="button" id="menu-toggle" aria-expanded="false" aria-controls="menu"
      class="btn btn-ghost !p-2.5 md:hidden"
      aria-label={t(lang, 'nav.openMenu')} data-close-label={t(lang, 'nav.closeMenu')}>
      <Icon name="menu" class="h-5 w-5" />
    </button>
  </nav>

  <div id="menu" class="border-t border-[color:var(--line)] bg-[color:var(--ink-900)] md:hidden">
    <ul class="shell flex flex-col py-3">
      {V2_NAV.map((item) => (
        <li><a href={`#${item.id}`} class="block py-3.5 text-lg">{t(lang, item.key as UiKey)}</a></li>
      ))}
      <li><a href={other.path} hreflang={other.lang} rel="alternate" class="block py-3.5 text-lg text-[color:var(--fg-2)]">{t(lang, 'nav.langNext')}</a></li>
    </ul>
  </div>
</header>
