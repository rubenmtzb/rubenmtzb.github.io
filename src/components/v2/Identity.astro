---
import { Picture } from 'astro:assets'
import { getCollection } from 'astro:content'
import Icon from '../Icon.astro'
import { getProfile, getStackByGroup } from '../../lib/content'
import { V2_ANCHOR_ALIASES, t, type Lang } from '../../i18n/ui'

interface Props { lang: Lang; cvPath: string }
const { lang, cvPath } = Astro.props

const profile = await getProfile(lang)

/** El retrato es el activo de identidad, no una fotografía del archivo. */
const portrait = (await getCollection('personal')).find((p) => p.id === 'portrait')?.data
const stack = await getStackByGroup()
const headline = [
  ...(stack.get('backend') ?? []),
  ...(stack.get('frontend') ?? []),
]
  .filter((s) => s.tier === 'actual')
  .slice(0, 3)
  .map((s) => s.name)

const parts = profile.name.split(' ')
const ICONS = { LinkedIn: 'linkedin', GitHub: 'github' } as const
---

<section id="identity" class="relative">
  {(V2_ANCHOR_ALIASES['identity'] ?? []).map((a) => <span id={a} class="anchor-alias" aria-hidden="true" />)}

  <div class="shell">
    <div class="grid min-h-[100svh] items-center gap-y-14 pb-24 pt-32 lg:grid-cols-12 lg:gap-x-12 lg:pt-28">
      <!-- El nombre a escala grande es lo primero que se lee -->
      <div class="lg:col-span-7 xl:col-span-7">
        <p class="t-meta reveal">{profile.jobTitle} — {profile.locality}, {lang === 'es' ? 'España' : 'Spain'}</p>

        <h1 class="t-name reveal mt-7" style="--i:1">
          {parts.map((word, i) => (
            <span class="block" style={`--i:${i + 1}`}>{word}</span>
          ))}
        </h1>

        <p class="t-lead reveal mt-9 max-w-[38ch]" style="--i:3">{profile.headline}</p>

        <ul class="reveal mt-8 flex flex-wrap items-center gap-x-3 gap-y-2" style="--i:4">
          {headline.map((name, i) => (
            <>
              {i > 0 && <li class="t-meta" aria-hidden="true">·</li>}
              <li class="t-meta text-[color:var(--fg-2)]">{name}</li>
            </>
          ))}
        </ul>

        <div class="reveal mt-11 flex flex-wrap items-center gap-4" style="--i:5">
          <a href="#work" class="btn btn-primary">
            {t(lang, 'v2.hero.cta')}
            <Icon name="arrowUpRight" class="h-4 w-4" />
          </a>
          <a href={cvPath} class="btn btn-ghost">{t(lang, 'v2.hero.cv')}</a>
        </div>

        <ul class="reveal mt-12 flex flex-wrap items-center gap-x-7 gap-y-3" style="--i:6">
          {profile.socials.map((s) => (
            <li>
              <a href={s.href} target="_blank" rel="noopener noreferrer" class="link-underline inline-flex items-center gap-2 text-sm">
                <Icon name={ICONS[s.label as keyof typeof ICONS] ?? 'globe'} class="h-4 w-4" />
                {s.label}
              </a>
            </li>
          ))}
        </ul>
      </div>

      <!--
        Retrato: la pieza visual del hero. Duotono azul con un foco que
        sigue al cursor y revela la versión iluminada. Sin JavaScript
        queda el duotono estático, que ya es una imagen acabada.
      -->
      <figure class="reveal relative m-0 lg:col-span-5" style="--i:2">
        <div id="portrait" class="portrait aspect-[4/5] w-full sm:aspect-[3/4]">
          {portrait && (
            <>
              <Picture
                src={portrait.image}
                formats={['avif', 'webp']}
                widths={[500, 900, 1400]}
                sizes="(max-width: 1024px) 92vw, 40vw"
                alt={portrait.alt[lang]}
                loading="eager"
                fetchpriority="high"
                class="portrait-base"
              />
              <Picture
                src={portrait.image}
                formats={['avif', 'webp']}
                widths={[500, 900, 1400]}
                sizes="(max-width: 1024px) 92vw, 40vw"
                alt=""
                aria-hidden="true"
                loading="eager"
                class="portrait-lit"
              />
            </>
          )}
          <span class="portrait-tint" aria-hidden="true"></span>
          <span class="portrait-grid" aria-hidden="true"></span>
          <span class="portrait-veil" aria-hidden="true"></span>
        </div>

        <figcaption class="mt-4 flex items-center justify-between gap-4">
          <span class="t-meta">{lang === 'es' ? 'El ingeniero' : 'The engineer'}</span>
          <span class="t-index">41.39 N · 2.16 E</span>
        </figcaption>
      </figure>
    </div>
  </div>
</section>
