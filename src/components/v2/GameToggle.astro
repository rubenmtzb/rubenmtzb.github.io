---
import { t, type Lang } from '../../i18n/ui'
interface Props { lang: Lang }
const { lang } = Astro.props
---
<!--
  Capa opcional. El botón se muestra solo si hay JavaScript y el usuario
  no ha pedido menos movimiento; el código del juego se descarga en el
  momento de activarlo, nunca antes.
-->
<div id="gm-root" class="gm-root" hidden>
  <button type="button" id="gm-toggle" class="gm-btn" aria-pressed="false">
    <span class="gm-dot" aria-hidden="true"></span>{t(lang, 'v2.game.toggle')}
  </button>
  <p id="gm-help" class="gm-help" hidden>{t(lang, 'v2.game.help')}</p>
</div>
