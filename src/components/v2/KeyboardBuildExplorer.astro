---
import { Picture } from 'astro:assets'
import { getKeyboards } from '../../lib/content'
import type { Lang } from '../../i18n/ui'

interface Props { lang: Lang }
const { lang } = Astro.props

const builds = await getKeyboards()

/** Resuelve un par {en, es} al idioma del documento. */
const pick = <T,>(pair: { en: T, es: T }) => (lang === 'es' ? pair.es : pair.en)

/**
 * Distribución 65 % del modelo: [unidades de ancho, glifo]. Solo alimenta la
 * geometría del teclado dibujado, que es común a todos los builds de este
 * tamaño; las fotos y la ficha técnica salen de la colección de contenido.
 */
const KEY_ROWS: Array<Array<[number, string]>> = [
  [[1, 'Esc'], [1, '1'], [1, '2'], [1, '3'], [1, '4'], [1, '5'], [1, '6'], [1, '7'], [1, '8'], [1, '9'], [1, '0'], [1, '-'], [1, '='], [2, 'Del'], [1, 'Pg']],
  [[1.5, 'Tab'], [1, 'Q'], [1, 'W'], [1, 'E'], [1, 'R'], [1, 'T'], [1, 'Y'], [1, 'U'], [1, 'I'], [1, 'O'], [1, 'P'], [1, '['], [1, ']'], [1.5, '\\'], [1, 'End']],
  [[1.75, 'Ctrl'], [1, 'A'], [1, 'S'], [1, 'D'], [1, 'F'], [1, 'G'], [1, 'H'], [1, 'J'], [1, 'K'], [1, 'L'], [1, ';'], [1, "'"], [2.25, 'Enter'], [1, 'Fn']],
  [[2.25, 'Shift'], [1, 'Z'], [1, 'X'], [1, 'C'], [1, 'V'], [1, 'B'], [1, 'N'], [1, 'M'], [1, ','], [1, '.'], [1, '/'], [1.75, 'Shift'], [1, 'Up'], [1, 'Fn']],
  [[1.25, 'Alt'], [1.25, 'Cmd'], [1.25, 'Fn'], [6.25, ''], [1.5, 'Alt'], [1.5, 'Fn'], [1, 'Left'], [1, 'Down'], [1, 'Right']],
]

const UNITS = 16

const keys = KEY_ROWS.flatMap((row, rowIndex) => {
  let x = 0
  return row.map(([width, label]) => {
    const key = { x, y: rowIndex, width, label }
    x += width
    return key
  })
})

/** Posición de una tecla en porcentaje del modelo: la comparten las 5 capas. */
const keyStyle = (key: typeof keys[number]) =>
  `--x:${(key.x / UNITS) * 100}%;--y:${key.y * 20}%;--w:${(key.width / UNITS) * 100}%`

/**
 * El escalonado de la explosión sale del orden de montaje, no de un número
 * escrito a mano por capa: la última pieza en montarse es la primera en
 * separarse, y añadir una pieza recoloca la secuencia sola.
 */
const STAGGER_MS = 70

/** El modelo dibuja las capas de abajo arriba; la ficha las lista al revés. */
type Part = (typeof builds)[number]['parts'][number]
const layerStyle = (part: Part, order: number) =>
  `--z:${part.z}px;--ze:${part.exploded}px;--delay:${order * STAGGER_MS}ms`

const copy = {
  intro: lang === 'es'
    ? 'Los teclados que he montado, pieza a pieza. Abre uno para verlo en fotos y para desmontarlo capa a capa en 3D.'
    : 'The keyboards I have built, piece by piece. Open one to see the photos and to take it apart layer by layer in 3D.',
  inspect: lang === 'es' ? 'Inspeccionar' : 'Inspect',
  allBuilds: lang === 'es' ? 'Todos los builds' : 'All builds',
  view: lang === 'es' ? 'Vista del teclado' : 'Keyboard view',
  photo: lang === 'es' ? 'Foto' : 'Photo',
  assembled: lang === 'es' ? 'Montado' : 'Assembled',
  exploded: lang === 'es' ? 'Explotado' : 'Exploded',
  separation: lang === 'es' ? 'Separación' : 'Separation',
  model: lang === 'es' ? 'Modelo interactivo por capas' : 'Interactive layered model',
  previous: lang === 'es' ? 'Foto anterior' : 'Previous photo',
  next: lang === 'es' ? 'Foto siguiente' : 'Next photo',
  goTo: lang === 'es' ? 'Ir a la foto' : 'Go to photo',
  order: lang === 'es' ? 'Orden de montaje' : 'Assembly order',
  pieces: lang === 'es' ? 'piezas' : 'parts',
  sheet: lang === 'es' ? 'Ficha técnica' : 'Spec sheet',
  realBuild: lang === 'es' ? 'BUILD REAL' : 'REAL BUILD',
  photoHint: lang === 'es'
    ? 'Fotografía original · flechas para recorrer los ángulos'
    : 'Original photograph · arrow keys to move through the angles',
  hintWide: lang === 'es'
    ? 'Arrastra o usa las flechas para orbitar · rueda para ampliar · doble clic para restablecer'
    : 'Drag or use the arrow keys to orbit · scroll to zoom · double-click to reset',
  hintNarrow: lang === 'es'
    ? 'Arrastra para orbitar · toca una pieza para aislarla'
    : 'Drag to orbit · tap a part to isolate',
}
---

<div
  id="kb-panel-photos"
  role="tabpanel"
  aria-labelledby="kb-tab-photos"
  class="kb-build-explorer hidden"
  data-kb-build-explorer
  data-assembled={copy.assembled}
  data-exploded={copy.exploded}
>
  <header class="bx-header">
    <div>
      <span class="bx-kicker">LABORATORY // BUILD ARCHIVE</span>
      <h4>{lang === 'es' ? 'Fotos de mis builds' : 'My build photos'}</h4>
    </div>
    <span class="bx-status"><i></i><span data-bx-status>{String(builds.length).padStart(2, '0')} BUILD // ARCHIVED</span></span>
  </header>

  <div class="bx-gallery" data-bx-gallery>
    <p class="bx-intro">{copy.intro}</p>

    <ul class="bx-build-grid">
      {builds.map((item, index) => (
        <li>
          <button class="bx-build-card" type="button" data-bx-open={item.key}>
            <span class="bx-card-visual">
              <Picture
                src={item.photos[0].image}
                formats={['avif']}
                fallbackFormat="webp"
                widths={[520, 780, 1100]}
                width={1100}
                quality={76}
                sizes="(max-width: 1024px) 92vw, 720px"
                alt={pick(item.photos[0].alt)}
                loading="lazy"
                decoding="async"
                class="bx-card-photo"
              />
              <span class="bx-card-index">BUILD {String(index + 1).padStart(2, '0')}</span>
              <span class="bx-card-authentic"><i></i>{copy.realBuild}</span>
            </span>
            <span class="bx-card-copy">
              <span class="bx-card-id">
                <strong>{item.name}</strong>
                <small>{pick(item.summary)}</small>
              </span>
              <span class="bx-card-meta">
                <span class="bx-card-year">{item.year}</span>
                <span class="bx-inspect">{copy.inspect} <b aria-hidden="true">→</b></span>
              </span>
            </span>
          </button>
        </li>
      ))}
    </ul>
  </div>

  <div class="bx-viewer" data-bx-viewer hidden>
    <div class="bx-toolbar">
      <button type="button" class="bx-back" data-bx-close>
        <span aria-hidden="true">←</span> {copy.allBuilds}
      </button>
      <div class="bx-view-switch" role="group" aria-label={copy.view}>
        <button type="button" data-bx-photo-view aria-pressed="true">{copy.photo}</button>
        <button type="button" data-bx-assembled-view aria-pressed="false">{copy.assembled}</button>
        <button type="button" data-bx-explode aria-pressed="false">{copy.exploded}</button>
      </div>
    </div>

    {builds.map((build) => (
      <div class="bx-build-panel" data-bx-build={build.key} hidden>
        <div class="bx-workbench">
          <div class="bx-stage-column">
            <div
              class="bx-stage"
              data-bx-stage
              tabindex="0"
              role="group"
              aria-label={`${copy.model} — ${build.name}`}
            >
              <div class="bx-photo-stage" data-bx-photo-stage>
                <div class="bx-photo-frame">
                  <div class="bx-photo-slides">
                    {build.photos.map((photo, index) => (
                      <figure
                        class:list={['bx-photo-slide', photo.cutout && 'is-render']}
                        data-bx-photo-slide={index}
                        data-bx-photo-label={pick(photo.label)}
                        style={`--ar:${photo.image.width} / ${photo.image.height};--fade-x:${photo.fade.x}%;--fade-y:${photo.fade.y}%`}
                        hidden={index !== 0}
                      >
                        <Picture
                          src={photo.image}
                          formats={['avif']}
                          fallbackFormat="webp"
                          widths={[520, 780, 1100]}
                          width={1100}
                          quality={76}
                          sizes="(max-width: 900px) 92vw, 660px"
                          alt={pick(photo.alt)}
                          loading="lazy"
                          decoding="async"
                          draggable="false"
                        />
                      </figure>
                    ))}
                  </div>
                  <span class="bx-photo-meta">
                    <span data-bx-photo-caption>{pick(build.photos[0].label)}</span>
                    <b data-bx-photo-counter>01 / {String(build.photos.length).padStart(2, '0')}</b>
                  </span>
                </div>
                <button class="bx-photo-nav bx-photo-prev" type="button" data-bx-photo-prev aria-label={copy.previous} title={copy.previous}>←</button>
                <button class="bx-photo-nav bx-photo-next" type="button" data-bx-photo-next aria-label={copy.next} title={copy.next}>→</button>
                <div class="bx-photo-dots">
                  {build.photos.map((photo, index) => (
                    <button
                      type="button"
                      data-bx-photo-dot={index}
                      aria-label={`${copy.goTo} ${index + 1}: ${pick(photo.label)}`}
                      aria-current={index === 0 ? 'true' : 'false'}
                    ></button>
                  ))}
                </div>
              </div>

              <div class="bx-model" data-bx-model>
                {[...build.parts].reverse().map((part, reverseIndex) => (
                  <div
                    class={`bx-layer bx-${part.id}`}
                    data-bx-part={part.id}
                    style={layerStyle(part, build.parts.length - 1 - reverseIndex)}
                  >
                    {part.id === 'weight' && <div class="bx-weight-strip"></div>}
                    {part.id === 'case' && <div class="bx-case-well"></div>}
                    {part.id === 'case' && <div class="bx-case-mark">{build.name.slice(0, 3).toUpperCase()}</div>}
                    {part.id === 'foam' && keys.map((key) => <i class="bx-cutout" style={keyStyle(key)}></i>)}
                    {part.id === 'pcb' && <div class="bx-circuit bx-circuit-a"></div>}
                    {part.id === 'pcb' && <div class="bx-circuit bx-circuit-b"></div>}
                    {part.id === 'pcb' && keys.map((key) => <i class="bx-socket" style={keyStyle(key)}></i>)}
                    {part.id === 'plate' && keys.map((key) => <i class="bx-cutout" style={keyStyle(key)}></i>)}
                    {part.id === 'switches' && keys.map((key) => <i class="bx-switch" style={keyStyle(key)}><b></b></i>)}
                    {part.id === 'keycaps' && keys.map((key) => <i class="bx-model-key" style={keyStyle(key)}><span>{key.label}</span></i>)}
                    <span class="bx-layer-tag" aria-hidden="true">{pick(part.label)}</span>
                  </div>
                ))}
              </div>

              <div class="bx-active-chip" data-bx-chip aria-live="polite">
                <b data-bx-chip-index>01</b>
                <span data-bx-chip-label>{pick(build.parts[0].label)}</span>
                <i></i>
                <small data-bx-chip-spec>{pick(build.parts[0].spec)}</small>
              </div>
              <span class="bx-view-readout" data-bx-readout>100% · 56° / -29°</span>
            </div>

            <div class="bx-scrub" data-bx-scrub hidden>
              <label for={`bx-spread-${build.key}`}>{copy.separation}</label>
              <input
                id={`bx-spread-${build.key}`}
                type="range"
                min="0"
                max="100"
                value="0"
                step="1"
                data-bx-range
              />
              <output data-bx-range-out>0%</output>
            </div>

            <p class="bx-hint">
              <span data-bx-photo-hint>{copy.photoHint}</span>
              <span data-bx-model-hint hidden>
                <span class="bx-hint-wide">{copy.hintWide}</span>
                <span class="bx-hint-narrow">{copy.hintNarrow}</span>
              </span>
            </p>
          </div>

          <aside class="bx-specs">
            <span class="bx-kicker">{build.name.toUpperCase()} // ARCHIVE</span>
            <h5>{build.name}</h5>
            <p>{pick(build.summary)}</p>

            <div class="bx-parts-head">
              <span>{copy.order}</span>
              <span>{build.parts.length} {copy.pieces}</span>
            </div>
            <ol class="bx-parts">
              {build.parts.map((part, index) => (
                <li>
                  <button type="button" data-bx-part-button={part.id} aria-pressed="false">
                    <span class="bx-part-index">{String(index + 1).padStart(2, '0')}</span>
                    <i style={`--swatch:${part.color}`}></i>
                    <span><strong>{pick(part.label)}</strong><small>{pick(part.spec)}</small></span>
                  </button>
                </li>
              ))}
            </ol>

            {build.specs.length > 0 && (
              <div class="bx-parts-head"><span>{copy.sheet}</span><span>{build.year}</span></div>
            )}
            {build.specs.length > 0 && (
              <dl class="bx-sheet">
                {build.specs.map((spec) => (
                  <div><dt>{pick(spec.label)}</dt><dd>{spec.value}</dd></div>
                ))}
              </dl>
            )}
          </aside>
        </div>
      </div>
    ))}
  </div>
</div>

<style>
  .kb-build-explorer {
    /* 0 montado, 1 totalmente separado: lo gobierna el deslizador. */
    --spread: 0;
    container-type: inline-size;
    border: 1px solid var(--line);
    border-radius: .75rem;
    background: var(--ink-800);
    padding: clamp(1rem, 2.2vw, 1.5rem);
    box-shadow: 0 20px 45px -28px rgba(0, 0, 0, .9);
  }
  .kb-build-explorer[hidden], .bx-viewer[hidden], .bx-gallery[hidden],
  .bx-scrub[hidden], .bx-build-panel[hidden] { display: none; }
  .bx-header, .bx-toolbar, .bx-card-copy, .bx-parts-head {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 1rem;
  }
  .bx-header { padding-bottom: .85rem; border-bottom: 1px solid var(--line-soft); }
  .bx-kicker {
    display: block;
    color: var(--cyan);
    font: 700 .66rem/1.2 var(--font-mono);
    letter-spacing: .12em;
  }
  .bx-header h4 { margin-top: .3rem; color: var(--fg); font-size: 1rem; font-weight: 700; }
  .bx-status {
    display: inline-flex;
    align-items: center;
    gap: .45rem;
    color: var(--fg-3);
    font: 500 .64rem/1 var(--font-mono);
    letter-spacing: .06em;
    white-space: nowrap;
  }
  .bx-status i, .bx-card-authentic i {
    width: .35rem;
    height: .35rem;
    border-radius: 50%;
    background: var(--cyan);
    box-shadow: 0 0 10px rgba(111, 227, 255, .55);
  }

  /* ---------------- Galería de builds ---------------- */
  .bx-gallery { padding-top: 1rem; }
  .bx-intro { max-width: 60ch; color: var(--fg-2); font-size: .82rem; line-height: 1.65; }
  .bx-build-grid {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(min(100%, 20rem), 1fr));
    gap: 1rem;
    margin-top: 1.15rem;
    list-style: none;
  }
  .bx-build-card {
    display: block;
    width: 100%;
    height: 100%;
    overflow: hidden;
    border: 1px solid var(--line);
    border-radius: .6rem;
    background: var(--ink-950);
    color: inherit;
    text-align: left;
    cursor: pointer;
    transition: transform .35s cubic-bezier(.22, 1, .36, 1), border-color .3s ease, box-shadow .3s ease;
  }
  .bx-build-card:hover { transform: translateY(-3px); border-color: rgba(111, 227, 255, .45); box-shadow: 0 24px 48px -30px #000; }
  .bx-build-card:focus-visible,
  .bx-back:focus-visible,
  .bx-view-switch button:focus-visible,
  .bx-photo-nav:focus-visible,
  .bx-photo-dots button:focus-visible,
  .bx-parts button:focus-visible,
  .bx-scrub input:focus-visible { outline: 2px solid var(--cyan); outline-offset: 3px; }
  .bx-card-visual {
    position: relative;
    display: grid;
    place-items: center;
    aspect-ratio: 2.35 / 1;
    overflow: hidden;
    background: radial-gradient(120% 100% at 50% 18%, rgba(43, 107, 255, .16), transparent 62%), var(--ink-950);
  }
  .bx-card-visual::after {
    content: '';
    position: absolute;
    inset: 0;
    z-index: 1;
    background: linear-gradient(180deg, rgba(5, 8, 15, .22), transparent 40%, rgba(5, 8, 15, .38));
    pointer-events: none;
  }
  .bx-card-visual :global(img) {
    width: 100%;
    height: 100%;
    object-fit: cover;
    transition: transform .7s cubic-bezier(.22, 1, .36, 1), filter .4s ease;
  }
  .bx-build-card:hover .bx-card-visual :global(img) { transform: scale(1.025); filter: brightness(1.06); }
  .bx-card-index, .bx-card-authentic { position: absolute; z-index: 2; top: .75rem; font: 600 .58rem/1 var(--font-mono); letter-spacing: .12em; }
  .bx-card-index { left: .8rem; color: var(--fg); text-shadow: 0 1px 8px rgba(0, 0, 0, .85); }
  .bx-card-authentic {
    right: .8rem;
    display: inline-flex;
    align-items: center;
    gap: .4rem;
    padding: .38rem .5rem;
    border: 1px solid rgba(111, 227, 255, .35);
    border-radius: .3rem;
    background: rgba(5, 8, 15, .72);
    color: var(--cyan);
    backdrop-filter: blur(8px);
  }
  .bx-card-copy { padding: .8rem .9rem; border-top: 1px solid var(--line-soft); }
  .bx-card-id { display: grid; gap: .2rem; min-width: 0; }
  .bx-card-id strong { color: var(--fg); font-size: .86rem; }
  .bx-card-id small, .bx-specs > p { color: var(--fg-3); font: 400 .63rem/1.35 var(--font-mono); }
  .bx-card-meta { display: grid; justify-items: end; gap: .3rem; }
  .bx-card-year { color: var(--fg-3); font: 400 .58rem/1 var(--font-mono); letter-spacing: .12em; }
  .bx-inspect { color: var(--cyan); font: 600 .65rem/1 var(--font-mono); white-space: nowrap; }
  .bx-inspect b { display: inline-block; margin-left: .2rem; transition: transform .2s ease; }
  .bx-build-card:hover .bx-inspect b { transform: translateX(3px); }

  /* ---------------- Visor ---------------- */
  .bx-viewer { padding-top: .9rem; }
  .bx-back { border: 0; background: transparent; color: var(--fg-3); font: 600 .68rem/1 var(--font-mono); cursor: pointer; }
  .bx-back:hover { color: var(--fg); }
  .bx-view-switch { display: grid; grid-template-columns: repeat(3, auto); padding: .2rem; border: 1px solid var(--line); border-radius: .45rem; background: var(--ink-950); }
  .bx-view-switch button { min-height: 1.9rem; padding: .35rem .65rem; border: 0; border-radius: .28rem; background: transparent; color: var(--fg-3); font: 600 .61rem/1 var(--font-mono); cursor: pointer; transition: background .2s ease, color .2s ease, box-shadow .2s ease; }
  .bx-view-switch button:hover { color: var(--fg); }
  .bx-view-switch button[aria-pressed='true'] { background: var(--ink-700); color: var(--cyan); box-shadow: inset 0 0 0 1px rgba(111, 227, 255, .32); }
  .bx-workbench {
    display: grid;
    grid-template-columns: minmax(0, 1.45fr) minmax(14rem, .8fr);
    gap: clamp(1rem, 2.4vw, 1.7rem);
    margin-top: .85rem;
    padding: clamp(.75rem, 2vw, 1.25rem);
  }
  .bx-stage-column { min-width: 0; }
  /*
   * El escenario crece con la separación en lugar de saltar entre dos
   * alturas: el mando es continuo, así que el encuadre también lo es y la
   * pila nunca se sale por arriba a mitad de recorrido.
   */
  .bx-stage {
    position: relative;
    display: grid;
    place-items: center;
    height: calc(var(--stage-h, 24rem) + var(--stage-grow, 8rem) * var(--spread));
    overflow: hidden;
    perspective: 1500px;
    perspective-origin: 50% 45%;
    touch-action: none;
    overscroll-behavior: contain;
    user-select: none;
    -webkit-user-select: none;
    cursor: grab;
    transition: height .7s cubic-bezier(.22, 1, .36, 1);
  }
  .bx-stage *, .bx-stage :global(img) { user-select: none; -webkit-user-select: none; -webkit-user-drag: none; }
  .bx-stage.is-dragging, .bx-stage.is-dragging .bx-layer { cursor: grabbing; }

  /* ---------------- Fotografía tratada como render de estudio ---------------- */
  .bx-photo-stage {
    position: absolute;
    inset: .25rem;
    z-index: 4;
    display: grid;
    place-items: center;
    opacity: 0;
    visibility: hidden;
    transform: translateY(5px);
    transition: opacity .4s ease, transform .5s cubic-bezier(.22, 1, .36, 1), visibility .4s;
  }
  /*
   * El marco reserva su pie con padding, así que la caja de las diapositivas
   * tiene altura definida y `max-height` sobre la imagen puede resolverse.
   * Con la altura en porcentaje sobre una caja automática, la foto vertical
   * se desbordaba por encima del contador y de los puntos.
   */
  .bx-photo-frame { position: absolute; inset: 0; width: min(88%, 44rem); padding-bottom: 2.6rem; margin-inline: auto; }
  /*
   * Contenedor de tamaño: da a la imagen una referencia de alto (`cqh`) con
   * la que calcular su propio ancho. Es lo que permite que la caja de la
   * imagen sea exactamente la fotografía —como haría `object-fit: contain`,
   * pero sin el hueco del letterbox— y por tanto que la máscara del borde
   * caiga sobre la foto y no sobre aire.
   */
  .bx-photo-slides { position: relative; container-type: size; width: 100%; height: 100%; }
  .bx-photo-slide { position: absolute; inset: 0; display: grid; place-items: center; margin: 0; }
  .bx-photo-slide[hidden] { display: none; }
  .bx-photo-frame :global(picture) { display: contents; }
  /*
   * La imagen se dimensiona a sí misma en lugar de estirarse a la caja: así
   * su caja coincide con la fotografía visible, que es la condición para
   * poder desvanecer el borde real y no el hueco del letterbox.
   */
  .bx-photo-stage :global(img) {
    position: relative;
    z-index: 1;
    display: block;
    max-width: 100%;
    max-height: 100%;
    /* `--ar` viene del tamaño real del fichero, así que no hay que medirlo. */
    aspect-ratio: var(--ar);
    width: min(100%, calc(var(--ar) * 100cqh));
    height: auto;
    border: 1px solid rgba(255, 255, 255, .06);
    border-radius: 6px;
    /*
     * Nivelado común a las cuatro tomas: se hicieron con luz de casa y a
     * distintas horas, así que un mismo grado de contraste y saturación las
     * convierte en una serie coherente en vez de cuatro fotos sueltas.
     */
    filter: contrast(1.12) saturate(1.06) brightness(1.03);
  }
  /*
