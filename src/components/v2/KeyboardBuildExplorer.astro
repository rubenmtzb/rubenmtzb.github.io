    padding: clamp(.75rem, 2vw, 1.25rem);
  }
  .bx-stage-column { min-width: 0; }
  /*
   * El escenario crece con la separación en lugar de saltar entre dos
   * alturas: el mando es continuo, así que el encuadre también lo es y la
   * pila nunca se sale por arriba a mitad de recorrido.
   */
  .bx-stage {
    position: relative;
    display: grid;
    place-items: center;
    height: calc(var(--stage-h, 24rem) + var(--stage-grow, 8rem) * var(--spread));
    overflow: hidden;
    perspective: 1500px;
    perspective-origin: 50% 45%;
    touch-action: none;
    overscroll-behavior: contain;
    user-select: none;
    -webkit-user-select: none;
    cursor: grab;
    transition: height .7s cubic-bezier(.22, 1, .36, 1);
  }
  .bx-stage *, .bx-stage :global(img) { user-select: none; -webkit-user-select: none; -webkit-user-drag: none; }
  .bx-stage.is-dragging, .bx-stage.is-dragging .bx-layer { cursor: grabbing; }

  /* ---------------- Modelo 3D por capas ---------------- */
  .bx-model {
    --rx: 56deg;
    --rz: -29deg;
    /* El encuadre se abre y el modelo baja a medida que la pila se separa. */
    --fit: calc(var(--fit-base, .64) - .06 * var(--spread));
    --zoom: 1;
    --offset-y: calc(42px * var(--spread));
    position: absolute;
    left: 50%;
    top: 50%;
    width: 502px;
    height: 172px;
    transform-style: preserve-3d;
    transform: translate(-50%, calc(-50% + var(--offset-y))) scale(calc(var(--fit) * var(--zoom))) rotateX(var(--rx)) rotateZ(var(--rz));
    opacity: 1;
    transition: transform .5s cubic-bezier(.22, 1, .36, 1), opacity .35s ease;
