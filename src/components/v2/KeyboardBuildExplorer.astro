  .kb-build-explorer.has-active .bx-layer:not(.is-active) { filter: brightness(.52) saturate(.6); opacity: .64; }
  .kb-build-explorer .bx-layer.is-active { filter: brightness(1.18) saturate(1.08); }

  /* Etiqueta flotante: aparece con la separación, como en un despiece técnico. */
  .bx-layer-tag {
    position: absolute;
    left: calc(100% + 30px);
    top: 50%;
    padding: 3px 6px;
    border: 1px solid rgba(111, 227, 255, .3);
    border-radius: 3px;
    background: rgba(6, 10, 18, .86);
    color: var(--cyan);
    font: 700 8px/1 var(--font-mono);
    letter-spacing: .1em;
    white-space: nowrap;
