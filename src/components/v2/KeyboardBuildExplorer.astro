---
import { Picture } from 'astro:assets'
import { getKeyboards } from '../../lib/content'
import '../../styles/keyboard-explorer.css'
import type { Lang } from '../../i18n/ui'

interface Props { lang: Lang }
const { lang } = Astro.props

const builds = await getKeyboards()
const buildDisplayStatus = (build: (typeof builds)[number]) =>
  build.buildInProgress ? 'in-progress' : build.status
const completeBuilds = builds.filter((build) => buildDisplayStatus(build) === 'complete').length

/** Resuelve un par {en, es} al idioma del documento. */
const pick = <T,>(pair: { en: T, es: T }) => (lang === 'es' ? pair.es : pair.en)

type KeyVariant =
  | 'neo-blue'
  | 'neo-red'
  | 'snow'
  | 'wasabi'
  | 'evo-white'
  | 'evo-grey'
  | 'evo-red'
  | 'corne-white'
type KeyArtwork = 'spade' | 'planet' | 'rocket' | 'comet' | 'constellation' | 'eclipse'
type KeyDetail = {
  secondary?: string
  functionLegend?: string
  artwork?: KeyArtwork
}
type KeyDefinition = [
  width: number,
  label: string,
  variant?: KeyVariant,
  gapBefore?: number,
  yOffset?: number,
  rotation?: number,
  detail?: KeyDetail,
]
type KeyRow = { offset?: number, keys: KeyDefinition[] }

const neoLegend = (label: string, secondary: string): KeyDefinition =>
  [1, label, undefined, undefined, undefined, undefined, { secondary }]

const neoNovelty = (
  width: number,
  variant: Extract<KeyVariant, 'neo-blue' | 'neo-red'>,
  artwork: KeyArtwork,
  gapBefore?: number,
): KeyDefinition =>
  [width, '', variant, gapBefore, undefined, undefined, { artwork }]

const hhkbLegend = (
  label: string,
  secondary: string,
  functionLegend: string,
): KeyDefinition =>
  [1, label, 'snow', undefined, undefined, undefined, { secondary, functionLegend }]

const ANSI65_ROWS: KeyRow[] = [
  { keys: [
    neoNovelty(1, 'neo-red', 'spade'),
    neoLegend('1', '!'), neoLegend('2', '@'), neoLegend('3', '#'),
    neoLegend('4', '$'), neoLegend('5', '%'), neoLegend('6', '^'),
    neoLegend('7', '&'), neoLegend('8', '*'), neoLegend('9', '('),
    neoLegend('0', ')'), neoLegend('-', '_'), neoLegend('=', '+'),
    neoNovelty(2, 'neo-blue', 'planet'),
    neoNovelty(1, 'neo-red', 'eclipse'),
  ] },
  { keys: [
    neoNovelty(1.5, 'neo-blue', 'rocket'),
    [1, 'Q'], [1, 'W'], [1, 'E'], [1, 'R'], [1, 'T'], [1, 'Y'],
    [1, 'U'], [1, 'I'], [1, 'O'], [1, 'P'], [1, '['], [1, ']'],
    neoNovelty(1.5, 'neo-red', 'planet'),
    neoNovelty(1, 'neo-blue', 'comet'),
  ] },
  { keys: [
    neoNovelty(1.75, 'neo-blue', 'planet'),
    [1, 'A'], [1, 'S'], [1, 'D'], [1, 'F'], [1, 'G'], [1, 'H'],
    [1, 'J'], [1, 'K'], [1, 'L'], [1, ';'], [1, "'"],
    neoNovelty(2.25, 'neo-blue', 'rocket'),
    neoNovelty(1, 'neo-blue', 'constellation'),
  ] },
  { keys: [
    [2.25, '⇧', 'neo-blue'],
    [1, 'Z'], [1, 'X'], [1, 'C'], [1, 'V'], [1, 'B'], [1, 'N'],
    [1, 'M'], [1, ','], [1, '.'], [1, '/'],
    neoNovelty(1.75, 'neo-blue', 'comet'),
    [1, '↑', 'neo-blue'],
    [1, '→', 'neo-blue'],
  ] },
  { keys: [
    neoNovelty(1.25, 'neo-blue', 'constellation'),
    [1.25, '⌘', 'neo-blue'],
    [1.25, '≡', 'neo-blue'],
    [6.25, ''],
    neoNovelty(1.25, 'neo-blue', 'rocket'),
    neoNovelty(1.25, 'neo-blue', 'comet'),
    [1, '←', 'neo-blue', .5],
    [1, '↓', 'neo-blue'],
    [1, '→', 'neo-blue'],
  ] },
]

/**
 * Distribución HHKB US de 60 teclas. La mezcla reproduce la unidad real:
 * alfas y espacio Wasabi; fila numérica y modificadores principalmente Snow.
 * El set es blank salvo por las doce teclas numéricas, que llevan símbolo,
 * carácter principal y la función F1–F12 impresa en el frente.
 */
const HHKB_ROWS: KeyRow[] = [
  { keys: [
    [1, '', 'wasabi'],
    hhkbLegend('1', '!', 'F1'),
    hhkbLegend('2', '@', 'F2'),
    hhkbLegend('3', '#', 'F3'),
    hhkbLegend('4', '$', 'F4'),
    hhkbLegend('5', '%', 'F5'),
    hhkbLegend('6', '^', 'F6'),
    hhkbLegend('7', '&', 'F7'),
    hhkbLegend('8', '*', 'F8'),
    hhkbLegend('9', '(', 'F9'),
    hhkbLegend('0', ')', 'F10'),
    hhkbLegend('-', '_', 'F11'),
    hhkbLegend('=', '+', 'F12'),
    [1, '', 'wasabi'],
    [1, '', 'wasabi'],
  ] },
  { keys: [[1.5, '', 'snow'], [1, '', 'wasabi'], [1, '', 'wasabi'], [1, '', 'wasabi'], [1, '', 'wasabi'], [1, '', 'wasabi'], [1, '', 'wasabi'], [1, '', 'wasabi'], [1, '', 'wasabi'], [1, '', 'wasabi'], [1, '', 'wasabi'], [1, '', 'wasabi'], [1, '', 'wasabi'], [1.5, '', 'snow']] },
  { keys: [[1.75, '', 'snow'], [1, '', 'wasabi'], [1, '', 'wasabi'], [1, '', 'wasabi'], [1, '', 'wasabi'], [1, '', 'wasabi'], [1, '', 'wasabi'], [1, '', 'wasabi'], [1, '', 'wasabi'], [1, '', 'wasabi'], [1, '', 'wasabi'], [1, '', 'wasabi'], [2.25, '', 'snow']] },
  { keys: [[2.25, '', 'snow'], [1, '', 'wasabi'], [1, '', 'wasabi'], [1, '', 'wasabi'], [1, '', 'wasabi'], [1, '', 'wasabi'], [1, '', 'wasabi'], [1, '', 'wasabi'], [1, '', 'wasabi'], [1, '', 'wasabi'], [1, '', 'wasabi'], [1.75, '', 'wasabi'], [1, '', 'snow']] },
  { offset: 1.5, keys: [[1.5, '', 'snow'], [1.5, '', 'snow'], [6, '', 'wasabi'], [1.5, '', 'snow'], [1.5, '', 'snow']] },
]

/**
 * Distribución ANSI de 80 teclas del EVO75. Los huecos reproducen la fila F,
 * el bloque de navegación y las flechas separados que aparecen en la unidad.
 */
const EVO75_ROWS: KeyRow[] = [
  { keys: [[1, 'Esc', 'evo-red'], [1, 'F1', 'evo-grey', .75], [1, 'F2', 'evo-grey'], [1, 'F3', 'evo-grey'], [1, 'F4', 'evo-grey'], [1, 'F5', 'evo-grey', .25], [1, 'F6', 'evo-grey'], [1, 'F7', 'evo-grey'], [1, 'F8', 'evo-grey'], [1, 'F9', 'evo-grey', .25], [1, 'F10', 'evo-grey'], [1, 'F11', 'evo-grey'], [1, 'F12', 'evo-grey'], [1, 'Del', 'evo-red', .75]] },
  { keys: [[1, '`', 'evo-grey'], [1, '1', 'evo-white'], [1, '2', 'evo-white'], [1, '3', 'evo-white'], [1, '4', 'evo-white'], [1, '5', 'evo-white'], [1, '6', 'evo-white'], [1, '7', 'evo-white'], [1, '8', 'evo-white'], [1, '9', 'evo-white'], [1, '0', 'evo-white'], [1, '-', 'evo-white'], [1, '=', 'evo-white'], [2, 'Back', 'evo-grey'], [1, 'Home', 'evo-grey', .25]] },
  { keys: [[1.5, 'Tab', 'evo-grey'], [1, 'Q', 'evo-white'], [1, 'W', 'evo-white'], [1, 'E', 'evo-white'], [1, 'R', 'evo-white'], [1, 'T', 'evo-white'], [1, 'Y', 'evo-white'], [1, 'U', 'evo-white'], [1, 'I', 'evo-white'], [1, 'O', 'evo-white'], [1, 'P', 'evo-white'], [1, '[', 'evo-white'], [1, ']', 'evo-white'], [1.5, '\\', 'evo-white'], [1, 'PgUp', 'evo-grey', .25]] },
  { keys: [[1.75, 'Caps', 'evo-grey'], [1, 'A', 'evo-white'], [1, 'S', 'evo-white'], [1, 'D', 'evo-white'], [1, 'F', 'evo-white'], [1, 'G', 'evo-white'], [1, 'H', 'evo-white'], [1, 'J', 'evo-white'], [1, 'K', 'evo-white'], [1, 'L', 'evo-white'], [1, ';', 'evo-white'], [1, "'", 'evo-white'], [2.25, 'Enter', 'evo-red'], [1, 'PgDn', 'evo-grey', .25]] },
  { keys: [[2.25, 'Shift', 'evo-grey'], [1, 'Z', 'evo-white'], [1, 'X', 'evo-white'], [1, 'C', 'evo-white'], [1, 'V', 'evo-white'], [1, 'B', 'evo-white'], [1, 'N', 'evo-white'], [1, 'M', 'evo-white'], [1, ',', 'evo-white'], [1, '.', 'evo-white'], [1, '/', 'evo-white'], [1.75, 'Shift', 'evo-grey'], [1, '↑', 'evo-grey', .25]] },
  { keys: [[1.25, 'Ctrl', 'evo-grey'], [1.25, 'Super', 'evo-grey'], [1.25, 'Alt', 'evo-grey'], [6.25, '', 'evo-white'], [1.25, 'Alt', 'evo-grey'], [1.25, 'Fn', 'evo-grey'], [1, '←', 'evo-grey', .75], [1, '↓', 'evo-grey'], [1, '→', 'evo-grey']] },
]

/** Corne estándar 3×6 + 3 por mitad, con stagger y pulgares espejados. */
const CORNE_ROWS: KeyRow[] = [
  { keys: [[1, '', 'corne-white', 0, .35], [1, '', 'corne-white', 0, .35], [1, '', 'corne-white', 0, .05], [1, '', 'corne-white', 0, -.15], [1, '', 'corne-white', 0, .05], [1, '', 'corne-white', 0, .3], [1, '', 'corne-white', 3.5, .3], [1, '', 'corne-white', 0, .05], [1, '', 'corne-white', 0, -.15], [1, '', 'corne-white', 0, .05], [1, '', 'corne-white', 0, .35], [1, '', 'corne-white', 0, .35]] },
  { keys: [[1, '', 'corne-white', 0, .35], [1, '', 'corne-white', 0, .35], [1, '', 'corne-white', 0, .05], [1, '', 'corne-white', 0, -.15], [1, '', 'corne-white', 0, .05], [1, '', 'corne-white', 0, .3], [1, '', 'corne-white', 3.5, .3], [1, '', 'corne-white', 0, .05], [1, '', 'corne-white', 0, -.15], [1, '', 'corne-white', 0, .05], [1, '', 'corne-white', 0, .35], [1, '', 'corne-white', 0, .35]] },
  { keys: [[1, '', 'corne-white', 0, .35], [1, '', 'corne-white', 0, .35], [1, '', 'corne-white', 0, .05], [1, '', 'corne-white', 0, -.15], [1, '', 'corne-white', 0, .05], [1, '', 'corne-white', 0, .3], [1, '', 'corne-white', 3.5, .3], [1, '', 'corne-white', 0, .05], [1, '', 'corne-white', 0, -.15], [1, '', 'corne-white', 0, .05], [1, '', 'corne-white', 0, .35], [1, '', 'corne-white', 0, .35]] },
  { offset: 3, keys: [[1, '', 'corne-white', 0, 0, -8], [1.1, '', 'corne-white', 0, -.04, -16], [1.4, '', 'corne-white', 0, .08, -25], [1.4, '', 'corne-white', 3, .08, 25], [1.1, '', 'corne-white', 0, -.04, 16], [1, '', 'corne-white', 0, 0, 8]] },
]

const MODEL_LAYOUTS = {
  ansi65: { units: 16, rows: ANSI65_ROWS },
  hhkb: { units: 15, rows: HHKB_ROWS },
  evo75: { units: 16.25, rows: EVO75_ROWS },
  corne: { units: 15.5, rows: CORNE_ROWS },
}

const modelKeys = ({ rows }: typeof MODEL_LAYOUTS[keyof typeof MODEL_LAYOUTS]) =>
  rows.flatMap((row, rowIndex) => {
    let x = row.offset ?? 0
    return row.keys.map(([width, label, variant, gapBefore = 0, yOffset = 0, rotation = 0, detail]) => {
      x += gapBefore
      const key = { x, y: rowIndex + yOffset, width, label, variant, rotation, ...detail }
      x += width
      return key
    })
  })

/**
 * Geometría de las teclas, emitida como hoja de estilo y no como atributo
 * `style` por elemento.
 *
 * Cada modelo dibuja las mismas teclas en todas sus capas —el hueco de la
 * espuma, el socket de la PCB, el switch, la tecla—, así que la posición de
 * la tecla 12 del EVO75 se repetía idéntica una decena de veces por panel y
 * con toda su precisión en coma flotante. Eran 1.486 atributos y 213 kB de
 * HTML para decir tres números por tecla. Aquí cada posición se escribe una
 * vez por modelo y el elemento se limita a nombrarla.
 *
 * Solo viajan los tres valores que distinguen una tecla de otra. La altura
 * de fila es constante dentro de un modelo, así que vive en el panel, y todo
 * lo que se derivaba de ella —altura de tecla, de switch, de socket— lo
 * calcula el CSS a partir de ella en lugar de recibirlo ya multiplicado.
 */

/** Cuatro decimales: sobre un modelo de 502 px son cinco milésimas de píxel. */
const percent = (value: number) => `${Number(value.toFixed(4))}%`

/** Nombre estable de la posición: lo comparten todas las capas del modelo. */
const keyClass = (index: number) => `bx-k${index}`

type Layout = typeof MODEL_LAYOUTS[keyof typeof MODEL_LAYOUTS]

const layoutGeometry = (name: string, layout: Layout) => {
  const scope = `.bx-build-panel[data-layout='${name}']`
  const rowHeight = 100 / layout.rows.length
  const positions = modelKeys(layout).map((key, index) => {
    const rotation = key.rotation === 0 ? '' : `;--kr:${key.rotation}deg`
    return `${scope} .${keyClass(index)}{--x:${percent((key.x / layout.units) * 100)};`
      + `--y:${percent(key.y * rowHeight)};`
      + `--w:${percent((key.width / layout.units) * 100)}${rotation}}`
  })
  return `${scope}{--row-h:${percent(rowHeight)}}${positions.join('')}`
}

/** Solo los modelos que algún build usa de verdad: nunca hay reglas de más. */
const KEY_GEOMETRY = [...new Set(builds.map((build) => build.layout))]
  .map((name) => layoutGeometry(name, MODEL_LAYOUTS[name]))
  .join('')

/**
 * El escalonado de la explosión sale del orden de montaje, no de un número
 * escrito a mano por capa: la última pieza en montarse es la primera en
 * separarse, y añadir una pieza recoloca la secuencia sola.
 */
const STAGGER_MS = 70

/**
 * Cortes de la portada fotográfica.
 *
 * La tarjeta nunca pasa de ~500 px de ancho —dos columnas dentro del panel,
 * una sola por debajo de 34rem— así que la escalera cubre hasta densidad 3x
 * y ahí se detiene: pedir el original de 1490 px para una tarjeta de 340 px
 * era gastar un megabyte en píxeles que la pantalla no puede enseñar.
 */
const PHOTO_WIDTHS = [420, 680, 1020, 1360]

/** Nunca pide al pipeline un corte mayor que el original de cada fotografía. */
const photoWidths = (intrinsic: number) => {
  const fitting = PHOTO_WIDTHS.filter((width) => width <= intrinsic)
  return fitting.length > 0 ? fitting : [intrinsic]
}

/**
 * El corte mayor que se llega a servir, que es también el `src` de respaldo.
 * Declarar aquí el original obligaba al pipeline a generar un corte extra a
 * tamaño completo que ninguna pantalla pedía: mismo aspecto, un fichero menos.
 */
const photoWidth = (intrinsic: number) => photoWidths(intrinsic).at(-1) ?? intrinsic

/**
 * Muestra de sonido de cada build.
 *
 * La envolvente viaja ya calculada desde el contenido —una altura por barra,
 * en escala de decibelios y con el mismo suelo para las tres tomas— así que
 * aquí solo se convierte en geometría. El cliente no decodifica
 * audio ni mide nada en tiempo real: pinta un trazo y desplaza un recorte
 * por encima conforme avanza la reproducción.
 *
 * Las 160 barras salen en un único `path` de segmentos verticales en lugar de
 * un elemento por barra. Con el trazo redondeado cada segmento se ve como una
 * barra, y el silencio —un segmento de altura mínima— queda en una línea a
 * media altura en vez de en un hueco.
 */
const WAVE_STEP = 3
const WAVE_HEIGHT = 100
const WAVE_FLOOR = 2

/**
 * La escala en decibelios deja el pico real por debajo del techo de la caja,
 * así que se estira hasta que la barra más alta lo toca. La ganancia se saca
 * del conjunto de las tomas y no de cada una: las alturas siguen midiéndose
 * con la misma vara —que es lo que las hace comparables entre teclados— y se
 * recalcula sola si mañana entra otra muestra.
 */
const WAVE_GAIN = WAVE_HEIGHT / Math.max(1, ...builds.flatMap((build) => build.sound?.peaks ?? []))

const wavePath = (peaks: number[]) =>
  peaks
    .map((peak, index) => {
      const top = Math.round((WAVE_HEIGHT - Math.max(WAVE_FLOOR, peak * WAVE_GAIN)) / 2)
      return `M${index * WAVE_STEP} ${top}V${WAVE_HEIGHT - top}`
    })
    .join('')

const waveWidth = (peaks: number[]) => (peaks.length - 1) * WAVE_STEP

/** El nivel es una medida: se escribe con signo menos, no con guion. */
const dbfs = (level: number) => `${level.toFixed(1).replace('-', '\u2212')} dBFS`

/** Duración en boca de reloj: los cortes no llegan al minuto, pero da igual. */
const clock = (seconds: number) =>
  `${Math.floor(seconds / 60)}:${String(Math.round(seconds % 60)).padStart(2, '0')}`

/** El modelo dibuja las capas de abajo arriba; la ficha las lista al revés. */
type Part = (typeof builds)[number]['parts'][number]
const layerStyle = (part: Part, order: number) =>
  `--z:${part.z}px;--ze:${part.exploded}px;--delay:${order * STAGGER_MS}ms`

const copy = {
  intro: lang === 'es'
    ? 'Un archivo en crecimiento: builds terminados, modelos en preparación y el próximo teclado en fase de concepto.'
    : 'A growing archive: completed builds, models in preparation and the next keyboard at concept stage.',
  inspect: lang === 'es' ? 'Inspeccionar' : 'Inspect',
  openDraft: lang === 'es' ? 'Abrir borrador' : 'Open draft',
  allBuilds: lang === 'es' ? 'Todos los builds' : 'All builds',
  view: lang === 'es' ? 'Vista del teclado' : 'Keyboard view',
  assembled: lang === 'es' ? 'Montado' : 'Assembled',
  exploded: lang === 'es' ? 'Explotado' : 'Exploded',
  separation: lang === 'es' ? 'Separación' : 'Separation',
  model: lang === 'es' ? 'Modelo interactivo por capas' : 'Interactive layered model',
  cover: lang === 'es' ? 'Portada fotográfica del build' : 'Build photo cover',
  previous: lang === 'es' ? 'Imagen anterior' : 'Previous image',
  next: lang === 'es' ? 'Imagen siguiente' : 'Next image',
  goTo: lang === 'es' ? 'Ir a la imagen' : 'Go to image',
  order: lang === 'es' ? 'Orden de montaje' : 'Assembly order',
  pieces: lang === 'es' ? 'piezas' : 'parts',
  sheet: lang === 'es' ? 'Ficha técnica' : 'Spec sheet',
  source: lang === 'es' ? 'Dónde conseguir' : 'Where to get',
  status: {
    complete: lang === 'es' ? 'BUILD REAL' : 'REAL BUILD',
    'in-progress': lang === 'es' ? 'EN CONSTRUCCIÓN' : 'BUILD IN PROGRESS',
    scaffold: lang === 'es' ? 'CAPAS EN PREP.' : 'LAYER DRAFT',
    planning: lang === 'es' ? 'EN PROCESO' : 'IN PROGRESS',
  },
  prototype: lang === 'es'
    ? 'MODELO PROVISIONAL // BASE DE CAPAS NEO65'
    : 'PROTOTYPE MODEL // NEO65 LAYER BASE',
  prototypePart: lang === 'es'
    ? 'Geometría temporal de referencia · pendiente de sustituir'
    : 'Temporary reference geometry · pending replacement',
  prototypeOrder: lang === 'es' ? 'Capas provisionales' : 'Prototype layers',
  hintWide: lang === 'es'
    ? 'Arrastra o usa las flechas para orbitar · rueda para ampliar · doble clic para restablecer'
    : 'Drag or use the arrow keys to orbit · scroll to zoom · double-click to reset',
  hintNarrow: lang === 'es'
    ? 'Arrastra para orbitar · toca una pieza para aislarla'
    : 'Drag to orbit · tap a part to isolate',
  soundTitle: lang === 'es' ? 'Prueba de sonido' : 'Sound test',
  soundRef: lang === 'es'
    ? 'Abre con tres chasquidos de referencia, iguales en las tres tomas.'
    : 'Opens with three reference snaps, identical across every take.',
  quipNext: lang === 'es' ? 'Que Killua cuente otra cosa' : 'Have Killua say something else',
  quipListen: lang === 'es'
    ? 'Chsss… escucha cómo entra el tecleo después de los chasquidos.'
    : 'Shhh… listen to how the typing comes in after the snaps.',
  play: lang === 'es' ? 'Reproducir muestra' : 'Play sample',
  pause: lang === 'es' ? 'Pausar muestra' : 'Pause sample',
  seek: lang === 'es' ? 'Posición dentro de la muestra' : 'Position within the sample',
  typing: lang === 'es' ? 'Tecleo' : 'Typing',
  soundPending: lang === 'es' ? 'SIN TOMA' : 'NO TAKE YET',
  soundPendingNote: lang === 'es'
    ? 'Se grabará cuando el build esté montado'
    : 'To be recorded once the build is assembled',
  noAudio: lang === 'es'
    ? 'Tu navegador no puede reproducir esta muestra.'
    : 'Your browser cannot play this sample.',
}
---

<div
  id="kb-panel-photos"
  role="tabpanel"
  aria-labelledby="kb-tab-photos"
  class="kb-build-explorer hidden"
  data-kb-build-explorer
  data-assembled={copy.assembled}
  data-exploded={copy.exploded}
>
  <style is:inline set:html={KEY_GEOMETRY}></style>

  <header class="bx-header">
    <div>
      <span class="bx-kicker">LABORATORY // BUILD ARCHIVE</span>
      <h4>{lang === 'es' ? 'Fotos de mis builds' : 'My build photos'}</h4>
    </div>
    <span class="bx-status">
      <i></i>
      <span data-bx-status>
        {String(builds.length).padStart(2, '0')} BUILDS // {String(completeBuilds).padStart(2, '0')} COMPLETE
      </span>
    </span>
  </header>

  <div class="bx-gallery" data-bx-gallery>
    <p class="bx-intro">{copy.intro}</p>

    <ul class="bx-build-grid">
      {builds.map((item, index) => (
        <li>
          <article class={`bx-build-card is-${buildDisplayStatus(item)}`} data-bx-open={item.key}>
            <div
              class="bx-card-visual"
              data-bx-card-carousel
              tabindex="0"
              role="region"
              aria-roledescription="carousel"
              aria-label={`${copy.cover}: ${item.name}`}
            >
              {item.photos.map((photo, photoIndex) => (
                <figure
                  class="bx-card-slide"
                  data-bx-card-slide={photoIndex}
                  data-bx-card-label={pick(photo.label)}
                  aria-hidden={photoIndex === 0 ? 'false' : 'true'}
                  hidden={photoIndex !== 0}
                >
                  <Picture
                    src={photo.image}
                    formats={['avif']}
                    fallbackFormat="webp"
                    widths={photoWidths(photo.image.width)}
                    width={photoWidth(photo.image.width)}
                    quality={82}
                    sizes="(max-width: 544px) calc(100vw - 4rem), (max-width: 1024px) 44vw, 340px"
                    alt={pick(photo.alt)}
                    loading="lazy"
                    decoding="async"
                    draggable="false"
                    class="bx-card-photo"
                  />
                </figure>
              ))}
              <span class="bx-card-pointer-light" aria-hidden="true"></span>
              <span class="bx-card-index">BUILD {String(index + 1).padStart(2, '0')}</span>
              <span class="bx-card-authentic"><i></i>{copy.status[buildDisplayStatus(item)]}</span>
              {item.photos.length > 1 && (
                <button class="bx-card-nav bx-card-prev" type="button" data-bx-card-prev aria-label={copy.previous}>‹</button>
              )}
              {item.photos.length > 1 && (
                <button class="bx-card-nav bx-card-next" type="button" data-bx-card-next aria-label={copy.next}>›</button>
              )}
              <span class="bx-card-photo-meta">
                <span data-bx-card-caption>{pick(item.photos[0].label)}</span>
                {item.photos.length > 1 && (
                  <b data-bx-card-counter>01 / {String(item.photos.length).padStart(2, '0')}</b>
                )}
              </span>
              {item.photos.length > 1 && (
                <span class="bx-card-pagination" role="group" aria-label={`${item.photos.length} ${lang === 'es' ? 'imágenes' : 'images'}`}>
                  {item.photos.map((photo, photoIndex) => (
                    <button
                      type="button"
                      data-bx-card-dot={photoIndex}
                      aria-label={`${copy.goTo} ${photoIndex + 1}: ${pick(photo.label)}`}
                      aria-current={photoIndex === 0 ? 'true' : 'false'}
                    ></button>
                  ))}
                </span>
              )}
            </div>
            <div class="bx-card-copy">
              <span class="bx-card-id">
                <strong>{item.name}</strong>
                <small>{pick(item.summary)}</small>
              </span>
              <span class="bx-card-meta">
                <button class="bx-inspect" type="button" data-bx-open={item.key}>
                  {item.status === 'complete' ? copy.inspect : copy.openDraft} <b aria-hidden="true">→</b>
                </button>
              </span>
            </div>
          </article>
        </li>
      ))}
    </ul>

  </div>

  <div class="bx-viewer" data-bx-viewer hidden>
    <div class="bx-toolbar">
      <button type="button" class="bx-back" data-bx-close>
        <span aria-hidden="true">←</span> {copy.allBuilds}
      </button>
      <div class="bx-view-switch" role="group" aria-label={copy.view}>
        <button type="button" data-bx-assembled-view aria-pressed="true">{copy.assembled}</button>
        <button type="button" data-bx-explode aria-pressed="false">{copy.exploded}</button>
      </div>
    </div>

    {builds.map((build) => {
      const layout = MODEL_LAYOUTS[build.layout]
      const keys = modelKeys(layout)
      return (
      <div
        class={`bx-build-panel is-${build.status} is-${buildDisplayStatus(build)}`}
        data-bx-build={build.key}
        data-layout={build.layout}
        hidden
      >
        <div class="bx-workbench">
          <div class="bx-stage-column">
            <div
              class="bx-stage"
              data-bx-stage
              tabindex="0"
              role="group"
              aria-label={`${copy.model} — ${build.name}`}
            >
              <!--
                El modelo es el reflejo visual del listado de piezas, no una
                segunda fuente: son más de mil elementos decorativos sin texto
                —huecos, sockets, muelles, teclas— que un lector de pantalla
                tendría que atravesar para llegar a la información, y esa
                información ya está escrita al lado, en la lista numerada.
              -->
              <div class="bx-model" data-bx-model aria-hidden="true">
                {[...build.parts].reverse().map((part, reverseIndex) => (
                  <div
                    class="bx-layer"
                    data-bx-part={part.id}
                    style={layerStyle(part, build.parts.length - 1 - reverseIndex)}
                  >
                    <!--
                      El atenuado de las piezas fuera de foco vive en la piel y
                      no en la capa. Un `filter` o una `opacity` convierten al
                      elemento en un grupo y aplanan el 3D de cuanto lleva
                      dentro: con la etiqueta colgando de la capa y no de la
                      piel, su contragiro sigue siendo tridimensional y el
                      texto se lee de frente aunque la pieza esté apagada.
                    -->
                    <div class={`bx-skin bx-${part.id}`}>
                      {part.id === 'weight' && (
                        <div class="bx-weight-strip">
                          {build.layout === 'evo75' && <i class="bx-evo-weight-vents is-left"></i>}
                          {build.layout === 'evo75' && <i class="bx-evo-weight-vents is-right"></i>}
                        </div>
                      )}
                      {(part.id === 'case' || part.id === 'bottom-case') && build.layout !== 'corne' && <div class="bx-case-well"></div>}
                      {(part.id === 'case' || part.id === 'bottom-case') && build.layout !== 'corne' && <div class="bx-case-mark">{build.name.slice(0, 3).toUpperCase()}</div>}
                      {part.id === 'case' && build.layout === 'hhkb' && <div class="bx-hhkb-battery"></div>}
                      {part.id === 'top-case' && <div class="bx-evo-case-opening"></div>}
                      {part.id === 'top-case' && <i class="bx-evo-grille is-left"></i>}
                      {part.id === 'top-case' && <i class="bx-evo-grille is-right"></i>}
                      {part.id === 'mount' && Array.from({ length: 8 }, (_, index) => <i class={`bx-evo-leaf is-${index + 1}`}></i>)}
                      {(part.id.includes('foam') || part.id === 'dampening') && keys.map((_key, index) => <i class={`bx-cutout ${keyClass(index)}`}></i>)}
                      {part.id === 'dampening' && <div class="bx-evo-silicone-core"></div>}
                      {part.id === 'battery' && <i class="bx-evo-cell is-left"></i>}
                      {part.id === 'battery' && <i class="bx-evo-cell is-right"></i>}
                      {build.layout === 'corne' && ['plate', 'pcb', 'spacers', 'bottom-case'].includes(part.id) && <i class={`bx-corne-half is-left is-${part.id}`}></i>}
                      {build.layout === 'corne' && ['plate', 'pcb', 'spacers', 'bottom-case'].includes(part.id) && <i class={`bx-corne-half is-right is-${part.id}`}></i>}
                      {part.id === 'pcb' && build.layout === 'corne' && <i class="bx-corne-mcu is-left"></i>}
                      {part.id === 'pcb' && build.layout === 'corne' && <i class="bx-corne-mcu is-right"></i>}
                      {part.id === 'interconnect' && <i class="bx-corne-cable"></i>}
                      {part.id === 'interconnect' && <i class="bx-corne-jack is-left"></i>}
                      {part.id === 'interconnect' && <i class="bx-corne-jack is-right"></i>}
                      {part.id === 'spacers' && Array.from({ length: 8 }, (_, index) => <i class={`bx-corne-standoff is-${index + 1}`}></i>)}
                      {part.id === 'feet' && Array.from({ length: 8 }, (_, index) => <i class={`bx-corne-foot is-${index + 1}`}></i>)}
                      {part.id === 'pcb' && <div class="bx-circuit bx-circuit-a"></div>}
                      {part.id === 'pcb' && <div class="bx-circuit bx-circuit-b"></div>}
                      {part.id === 'pcb' && build.layout !== 'hhkb' && keys.map((_key, index) => <i class={`bx-socket ${keyClass(index)}`}></i>)}
                      {part.id === 'pcb' && build.layout === 'hhkb' && keys.map((_key, index) => <i class={`bx-cap-pad ${keyClass(index)}`}></i>)}
                      {part.id === 'plate' && keys.map((_key, index) => <i class={`bx-cutout ${keyClass(index)}`}></i>)}
                      {part.id === 'switches' && keys.map((_key, index) => <i class={`bx-switch ${keyClass(index)}`}><b></b></i>)}
                      {part.id === 'sliders' && keys.map((_key, index) => <i class={`bx-topre-slider ${keyClass(index)}`}><b></b></i>)}
                      {part.id === 'housing' && keys.map((_key, index) => <i class={`bx-housing-bore ${keyClass(index)}`}></i>)}
                      {part.id === 'domes' && keys.map((_key, index) => <i class={`bx-topre-dome ${keyClass(index)}`}></i>)}
                      {part.id === 'springs' && keys.map((_key, index) => <i class={`bx-topre-spring ${keyClass(index)}`}></i>)}
                      {part.id === 'keycaps' && keys.map((key, index) => (
                        <i class:list={['bx-model-key', keyClass(index), key.variant && `is-${key.variant}`]}>
                          {key.artwork && (
                            <svg class="bx-key-art" viewBox="0 0 32 20" aria-hidden="true">
                              {key.artwork === 'spade' && (
                                <path class="is-fill" d="M16 1.5C13.7 5.4 7.2 7.8 7.2 12.7c0 2.9 2.2 4.8 4.8 4.8 1.3 0 2.4-.4 3.1-1.2-.2 1.2-.8 2-2.2 2.7h6.2c-1.4-.7-2-1.5-2.2-2.7.7.8 1.8 1.2 3.1 1.2 2.6 0 4.8-1.9 4.8-4.8 0-4.9-6.5-7.3-8.8-11.2Z" />
                              )}
                              {key.artwork === 'planet' && (
                                <>
                                  <circle class="is-fill" cx="16" cy="10" r="5.2" />
                                  <ellipse cx="16" cy="10" rx="12.5" ry="4.2" transform="rotate(-13 16 10)" />
                                  <circle class="is-cutout" cx="14.2" cy="8.3" r="1.1" />
                                </>
                              )}
                              {key.artwork === 'rocket' && (
                                <>
                                  <path d="M6 15.8c4.8-1 8-3.4 10.2-8.1 1.2-2.5 3.6-4.4 7.7-5.5-.8 4.2-2.4 6.8-4.7 8.2-4.3 2.7-7.4 3.1-13.2 5.4Z" />
                                  <path d="m11 13-3.8-.8 2.7-2.1M16.9 8.5l2.5 3.1-3.3.7" />
                                  <circle class="is-fill" cx="19.7" cy="6.1" r="1.25" />
                                  <path d="m8.8 15.1-3 2.2m5.7-3-2.3 3.2" />
                                </>
                              )}
                              {key.artwork === 'comet' && (
                                <>
                                  <path d="M3 16.4C9.5 16 13.2 13.6 17 8.2M5.4 18c6.1-1.2 10.2-3.4 13.4-7.8" />
                                  <path class="is-fill" d="m21.6 2.1 1.5 3 3.4.5-2.5 2.3.6 3.3-3-1.6-3 1.6.6-3.3-2.5-2.3 3.4-.5 1.5-3Z" />
                                </>
                              )}
                              {key.artwork === 'constellation' && (
                                <>
                                  <path d="m5 14 7-8 6 5 8-7M12 6l2 10 4-5" />
                                  <circle class="is-fill" cx="5" cy="14" r="1.7" />
                                  <circle class="is-fill" cx="12" cy="6" r="1.5" />
                                  <circle class="is-fill" cx="14" cy="16" r="1.3" />
                                  <circle class="is-fill" cx="18" cy="11" r="1.6" />
                                  <circle class="is-fill" cx="26" cy="4" r="1.8" />
                                </>
                              )}
                              {key.artwork === 'eclipse' && (
                                <>
                                  <path class="is-fill" d="M18.4 3.1a7 7 0 1 0 0 13.8A5.7 5.7 0 1 1 18.4 3Z" />
                                  <path d="m23.7 3.2.7 1.5 1.7.2-1.2 1.2.3 1.7-1.5-.8-1.6.8.3-1.7-1.2-1.2 1.6-.2.8-1.5Z" />
                                </>
                              )}
                            </svg>
                          )}
                          {!key.artwork && key.label && (
                            <span>
                              {key.label}
                              {key.secondary && <small>{key.secondary}</small>}
                              {key.functionLegend && <em class="bx-key-function">{key.functionLegend}</em>}
                            </span>
                          )}
                        </i>
                      ))}
                    </div>
                    <span class="bx-layer-tag" aria-hidden="true">{pick(part.label)}</span>
                  </div>
                ))}
              </div>

              {build.status !== 'complete' && (
                <span class="bx-prototype-note">{copy.prototype}</span>
              )}
              <div class="bx-active-chip" data-bx-chip aria-live="polite">
                <b data-bx-chip-index>01</b>
                <span data-bx-chip-label>{pick(build.parts[0].label)}</span>
                <i></i>
                <small data-bx-chip-spec>
                  {build.status === 'complete' ? pick(build.parts[0].spec) : copy.prototypePart}
                </small>
              </div>
              <span class="bx-view-readout" data-bx-readout>100% · 56° / -29°</span>
            </div>

            <div class="bx-scrub" data-bx-scrub>
              <label for={`bx-spread-${build.key}`}>{copy.separation}</label>
              <input
                id={`bx-spread-${build.key}`}
                type="range"
                min="0"
                max="100"
                value="0"
                step="1"
                data-bx-range
              />
              <output data-bx-range-out>0%</output>
            </div>
            <p class="bx-hint">
              <span>
                <span class="bx-hint-wide">{copy.hintWide}</span>
                <span class="bx-hint-narrow">{copy.hintNarrow}</span>
              </span>
            </p>
          </div>

          <aside class="bx-specs">
            <span class="bx-kicker">{build.name.toUpperCase()} // ARCHIVE</span>
            <h5>{build.name}</h5>
            <span class="bx-detail-status"><i></i>{copy.status[buildDisplayStatus(build)]}</span>
            <p>{pick(build.summary)}</p>

            <div class="bx-parts-head">
              <span>{build.status === 'complete' ? copy.order : copy.prototypeOrder}</span>
              <span>{build.parts.length} {copy.pieces}</span>
            </div>
            <ol class="bx-parts">
              {build.parts.map((part, index) => (
                <li>
                  <button type="button" data-bx-part-button={part.id} aria-pressed="false">
                    <span class="bx-part-index">{String(index + 1).padStart(2, '0')}</span>
                    <i style={`--swatch:${part.color}`}></i>
                    <span>
                      <strong>{pick(part.label)}</strong>
                      <small>{build.status === 'complete' ? pick(part.spec) : copy.prototypePart}</small>
                    </span>
                  </button>
                  {build.status === 'complete' && part.source && (
                    <a
                      class="bx-source"
                      href={part.source.href}
                      target="_blank"
                      rel="noopener noreferrer"
                      aria-label={`${copy.source} ${pick(part.label)}: ${part.source.label}`}
                    >
                      <i aria-hidden="true"></i>
                      <span>{part.source.label}</span>
                      <svg width="9" height="9" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="3" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                        <path d="M7 17 17 7"></path><path d="M8 7h9v9"></path>
                      </svg>
                    </a>
                  )}
                </li>
              ))}
            </ol>

            <!--
              El sonido es una propiedad del build, así que se escucha aquí,
              con el despiece delante y la ficha debajo, y no en un banco
              aparte: al entrar en un teclado se ve cómo está montado y se
              oye cómo suena sin salir de la misma pantalla.
            -->
            <div class="bx-parts-head">
              <span>{copy.soundTitle}</span>
              <span>{build.sound ? clock(build.sound.duration) : copy.soundPending}</span>
            </div>
            <!--
              Solo asoman los builds montados buscando el silencio: son los
              únicos que tienen algo que contar sobre por qué suenan así. El
              adorno sale del contenido —si no hay apuntes, no hay nadie
              asomado— y nunca al revés.
            -->
            {build.sound?.quips && (
              <div class="bx-quip" data-bx-quip>
                <div class="bx-quip-bubble">
                  <p data-bx-quip-text aria-live="polite">{pick(build.sound.quips)[0]}</p>
                  <i class="bx-quip-tail" aria-hidden="true"></i>
                </div>
                <button
                  type="button"
                  class="bx-quip-poke"
                  data-bx-quip-next
                  data-quips={JSON.stringify(pick(build.sound.quips))}
                  data-listen={copy.quipListen}
                  aria-label={copy.quipNext}
                >
                  <img
                    src="/killua-pixel.png"
                    width="132"
                    height="293"
                    alt=""
                    aria-hidden="true"
                    decoding="async"
                    loading="lazy"
                    draggable="false"
                  />
                </button>
              </div>
            )}
            {build.sound ? (
              <div
                class="bx-clip"
                data-bx-clip={build.sound.clip}
                data-duration={build.sound.duration}
                style={`--ref:${((build.sound.typingFrom / build.sound.duration) * 100).toFixed(2)}%`}
              >
                <!--
                  `preload="none"`: entrar en la ficha no descarga nada hasta
                  que alguien pulsa. Dos fuentes porque el AAC es más limpio a
                  este bitrate y el MP3 no lo rechaza ningún navegador.
                -->
                <audio preload="none" data-bx-clip-audio>
                  <source src={`/keyboards/sound/${build.sound.clip}.m4a`} type="audio/mp4" />
                  <source src={`/keyboards/sound/${build.sound.clip}.mp3`} type="audio/mpeg" />
                  {copy.noAudio}
                </audio>

                <div class="bx-clip-head">
                  <button
                    class="bx-clip-play"
                    type="button"
                    data-bx-clip-toggle
                    data-play={`${copy.play}: ${build.name}`}
                    data-pause={`${copy.pause}: ${build.name}`}
                    aria-label={`${copy.play}: ${build.name}`}
                  >
                    <svg class="is-play" width="15" height="15" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true">
                      <path d="M9 6.1v11.8a.9.9 0 0 0 1.37.77l9.5-5.9a.9.9 0 0 0 0-1.54l-9.5-5.9A.9.9 0 0 0 9 6.1Z"></path>
                    </svg>
                    <svg class="is-pause" width="15" height="15" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true">
                      <rect x="7.6" y="5.5" width="3.4" height="13" rx="1.1"></rect>
                      <rect x="13" y="5.5" width="3.4" height="13" rx="1.1"></rect>
                    </svg>
                  </button>
                  <span class="bx-clip-level">{copy.typing} {dbfs(build.sound.level)}</span>
                  <b class="bx-clip-time"><span data-bx-clip-now>0:00</span> / {clock(build.sound.duration)}</b>
                </div>

                <div class="bx-clip-wave">
                  <svg viewBox={`0 0 ${waveWidth(build.sound.peaks)} ${WAVE_HEIGHT}`} preserveAspectRatio="none" aria-hidden="true">
                    <path d={wavePath(build.sound.peaks)} vector-effect="non-scaling-stroke"></path>
                  </svg>
                  <svg class="is-played" viewBox={`0 0 ${waveWidth(build.sound.peaks)} ${WAVE_HEIGHT}`} preserveAspectRatio="none" aria-hidden="true">
                    <path d={wavePath(build.sound.peaks)} vector-effect="non-scaling-stroke"></path>
                  </svg>
                  <i class="bx-clip-ref" aria-hidden="true"><span>REF</span></i>
                  <!--
                    El cabezal es un control nativo con la pista invisible: sale
                    gratis el arrastre, las flechas y el anuncio del avance.
                  -->
                  <input
                    type="range"
                    min="0"
                    max="1000"
                    value="0"
                    step="1"
                    data-bx-clip-seek
                    aria-label={`${copy.seek}: ${build.name}`}
                    aria-valuetext="0:00"
                  />
                </div>

                <p class="bx-clip-note">{pick(build.sound.character)}</p>
                <p class="bx-clip-note is-ref">{copy.soundRef}</p>
              </div>
            ) : (
              <p class="bx-clip-note">{copy.soundPendingNote}</p>
            )}

            {build.specs.length > 0 && (
              <div class="bx-parts-head"><span>{copy.sheet}</span></div>
            )}
            {build.specs.length > 0 && (
              <dl class="bx-sheet">
                {build.specs.map((spec) => (
                  <div><dt>{pick(spec.label)}</dt><dd>{pick(spec.value)}</dd></div>
                ))}
              </dl>
            )}
          </aside>
        </div>
      </div>
      )
    })}
  </div>
</div>
