    transform-style: preserve-3d;
    /* Una sola expresión interpola entre montado y explotado. */
    transform: translateZ(calc(var(--z) + (var(--ze) - var(--z)) * var(--spread)));
    transition: transform .82s cubic-bezier(.32, 1.22, .4, 1), filter .25s ease, opacity .25s ease;
