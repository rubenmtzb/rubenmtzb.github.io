---
import { Picture } from 'astro:assets'
import type { Lang } from '../../i18n/ui'
import neo65Front from '../../assets/keyboards/neo65-gallery/front-dark.webp'
import neo65Angle from '../../assets/keyboards/neo65-gallery/angle.webp'
import neo65Profile from '../../assets/keyboards/neo65-gallery/profile.webp'
import neo65RearWeight from '../../assets/keyboards/neo65-gallery/rear-weight.webp'

interface Props { lang: Lang }
const { lang } = Astro.props

const photos = [
  {
    src: neo65Front,
    label: lang === 'es' ? 'FRONTAL' : 'FRONT',
    alt: lang === 'es' ? 'Vista frontal oscura del teclado mecánico Neo65' : 'Dark front view of the Neo65 mechanical keyboard',
  },
  {
    src: neo65Angle,
    label: lang === 'es' ? 'ÁNGULO' : 'THREE-QUARTER',
    alt: lang === 'es' ? 'Vista diagonal del Neo65 y sus keycaps PBTfans Frontier' : 'Three-quarter view of the Neo65 and its PBTfans Frontier keycaps',
  },
  {
    src: neo65Profile,
    label: lang === 'es' ? 'PERFIL' : 'LOW PROFILE',
    alt: lang === 'es' ? 'Perfil bajo del chasis y las keycaps del Neo65' : 'Low profile of the Neo65 case and keycaps',
  },
  {
    src: neo65RearWeight,
    label: lang === 'es' ? 'CONTRAPESO' : 'REAR WEIGHT',
    alt: lang === 'es' ? 'Reverso del Neo65 con contrapeso PVD iridiscente' : 'Underside of the Neo65 with iridescent PVD rear weight',
  },
]

const keyRows: Array<Array<[number, string]>> = [
  [[1, 'Esc'], [1, '1'], [1, '2'], [1, '3'], [1, '4'], [1, '5'], [1, '6'], [1, '7'], [1, '8'], [1, '9'], [1, '0'], [1, '-'], [1, '='], [2, 'Del'], [1, 'Pg']],
  [[1.5, 'Tab'], [1, 'Q'], [1, 'W'], [1, 'E'], [1, 'R'], [1, 'T'], [1, 'Y'], [1, 'U'], [1, 'I'], [1, 'O'], [1, 'P'], [1, '['], [1, ']'], [1.5, '\\'], [1, 'End']],
  [[1.75, 'Ctrl'], [1, 'A'], [1, 'S'], [1, 'D'], [1, 'F'], [1, 'G'], [1, 'H'], [1, 'J'], [1, 'K'], [1, 'L'], [1, ';'], [1, "'"], [2.25, 'Enter'], [1, 'Fn']],
  [[2.25, 'Shift'], [1, 'Z'], [1, 'X'], [1, 'C'], [1, 'V'], [1, 'B'], [1, 'N'], [1, 'M'], [1, ','], [1, '.'], [1, '/'], [1.75, 'Shift'], [1, 'Up'], [1, 'Fn']],
  [[1.25, 'Alt'], [1.25, 'Cmd'], [1.25, 'Fn'], [6.25, ''], [1.5, 'Alt'], [1.5, 'Fn'], [1, 'Left'], [1, 'Down'], [1, 'Right']],
]

const units = 16
const keys = keyRows.flatMap((row, rowIndex) => {
  let x = 0
  return row.map(([width, label]) => {
    const key = { x, y: rowIndex, width, label }
    x += width
    return key
  })
})

const parts = [
  { id: 'keycaps', label: lang === 'es' ? 'KEYCAPS' : 'KEYCAPS', spec: 'PBTfans Frontier · doubleshot PBT', color: '#73766d', z: 46, exploded: 300 },
  { id: 'switches', label: lang === 'es' ? 'SWITCHES' : 'SWITCHES', spec: 'Gazzew Boba U4 · silent tactile', color: '#eef1f4', z: 28, exploded: 232 },
  { id: 'plate', label: lang === 'es' ? 'PLACA' : 'PLATE', spec: lang === 'es' ? 'Polipropileno negro · 1,5 mm' : 'Black polypropylene · 1.5 mm', color: '#262a30', z: 19, exploded: 172 },
  { id: 'pcb', label: 'PCB', spec: lang === 'es' ? 'Hotswap cableada · sin flex cuts' : 'Wired hotswap · non-flex cut', color: '#e6eaef', z: 11, exploded: 118 },
  { id: 'foam', label: 'FOAM', spec: lang === 'es' ? 'Poron en case, placa y PCB' : 'Poron case, plate & PCB foam', color: '#1b1e23', z: 3, exploded: 66 },
  { id: 'case', label: 'CASE', spec: lang === 'es' ? 'Aluminio CNC · anodizado azul marino' : 'CNC aluminium · navy anodised', color: '#34466f', z: 0, exploded: 0 },
  { id: 'weight', label: lang === 'es' ? 'CONTRAPESO' : 'REAR WEIGHT', spec: lang === 'es' ? 'Acabado espejo · PVD iridiscente' : 'Mirror-polished · iridescent PVD', color: '#9d8a5e', z: -34, exploded: -150 },
]

const keyStyle = (key: typeof keys[number]) =>
  `--x:${(key.x / units) * 100}%;--y:${key.y * 20}%;--w:${(key.width / units) * 100}%`
---

<div
  id="kb-panel-photos"
  role="tabpanel"
  aria-labelledby="kb-tab-photos"
  class="kb-build-explorer hidden"
  data-kb-build-explorer
  data-assembled={lang === 'es' ? 'Montado' : 'Assembled'}
  data-exploded={lang === 'es' ? 'Explotado' : 'Exploded'}
>
  <header class="bx-header">
    <div>
      <span class="bx-kicker">LABORATORY // BUILD ARCHIVE</span>
      <h4>{lang === 'es' ? 'Fotos de mis builds' : 'My build photos'}</h4>
    </div>
    <span class="bx-status"><i></i><span data-bx-status>01 BUILD // ARCHIVED</span></span>
  </header>

  <div class="bx-gallery" data-bx-gallery>
    <p class="bx-intro">
      {lang === 'es'
        ? 'Una vista de los teclados que he montado. Abre uno para inspeccionar cada pieza en el orden real de ensamblaje.'
        : "A view into the keyboards I've built. Open one to inspect every part in its real assembly order."}
    </p>

    <button class="bx-build-card" type="button" data-bx-open>
      <span class="bx-card-visual">
        <Picture
          src={neo65Front}
          formats={['avif', 'webp']}
          widths={[720, 1100, 1600]}
          sizes="(max-width: 1024px) 100vw, 760px"
          alt={lang === 'es' ? 'Teclado mecánico Neo65 terminado con keycaps PBTfans Frontier' : 'Finished Neo65 mechanical keyboard with PBTfans Frontier keycaps'}
          loading="lazy"
          decoding="async"
          class="bx-card-photo"
        />
        <span class="bx-card-index">BUILD 01</span>
        <span class="bx-card-authentic"><i></i>{lang === 'es' ? 'BUILD REAL' : 'REAL BUILD'}</span>
      </span>
      <span class="bx-card-copy">
        <span>
          <strong>Neo65</strong>
          <small>65% · Gasket mount · Wired hotswap</small>
        </span>
        <span class="bx-inspect">{lang === 'es' ? 'Inspeccionar' : 'Inspect'} <b aria-hidden="true">→</b></span>
      </span>
    </button>
  </div>

  <div class="bx-viewer" data-bx-viewer hidden>
    <div class="bx-toolbar">
      <button type="button" class="bx-back" data-bx-close>
        <span aria-hidden="true">←</span> {lang === 'es' ? 'Todos los builds' : 'All builds'}
      </button>
      <div class="bx-view-switch" role="group" aria-label={lang === 'es' ? 'Vista del teclado' : 'Keyboard view'}>
        <button type="button" data-bx-photo-view aria-pressed="true">{lang === 'es' ? 'Foto' : 'Photo'}</button>
        <button type="button" data-bx-assembled-view aria-pressed="false">{lang === 'es' ? 'Montado' : 'Assembled'}</button>
        <button type="button" data-bx-explode aria-pressed="false">{lang === 'es' ? 'Explotado' : 'Exploded'}</button>
      </div>
    </div>

    <div class="bx-workbench">
      <div class="bx-stage-column">
        <div
          class="bx-stage"
          data-bx-stage
          tabindex="0"
          role="group"
          aria-label={lang === 'es' ? 'Modelo interactivo por capas del teclado Neo65' : 'Interactive layered model of the Neo65 keyboard'}
        >
          <div class="bx-photo-stage" data-bx-photo-stage>
            <div class="bx-photo-frame">
              <div class="bx-photo-slides" data-bx-photo-slides>
                {photos.map((photo, index) => (
                  <figure class="bx-photo-slide" data-bx-photo-slide={index} data-bx-photo-label={photo.label} hidden={index !== 0}>
                    <Picture
                      src={photo.src}
                      formats={['avif', 'webp']}
                      widths={[720, 1100, 1600]}
                      sizes="(max-width: 900px) 100vw, 680px"
                      alt={photo.alt}
                      loading="lazy"
                      decoding="async"
                      draggable="false"
                    />
                  </figure>
                ))}
              </div>
              <span class="bx-photo-meta">
                <span data-bx-photo-caption>{photos[0].label}</span>
                <b data-bx-photo-counter>01 / {String(photos.length).padStart(2, '0')}</b>
              </span>
            </div>
            <button class="bx-photo-nav bx-photo-prev" type="button" data-bx-photo-prev aria-label={lang === 'es' ? 'Foto anterior' : 'Previous photo'} title={lang === 'es' ? 'Foto anterior' : 'Previous photo'}>←</button>
            <button class="bx-photo-nav bx-photo-next" type="button" data-bx-photo-next aria-label={lang === 'es' ? 'Foto siguiente' : 'Next photo'} title={lang === 'es' ? 'Foto siguiente' : 'Next photo'}>→</button>
          </div>

          <div class="bx-model" data-bx-model>
            <div class="bx-floor"></div>

            <div class="bx-layer bx-weight" data-bx-part="weight" style="--z:-34px;--ze:-150px;--delay:0ms">
              <div class="bx-weight-strip"></div>
            </div>

            <div class="bx-layer bx-case" data-bx-part="case" style="--z:0px;--ze:0px;--delay:70ms">
              <div class="bx-case-well"></div>
              <div class="bx-case-mark">NEO</div>
            </div>

            <div class="bx-layer bx-foam" data-bx-part="foam" style="--z:3px;--ze:66px;--delay:140ms">
              {keys.map((key) => <i class="bx-cutout" style={keyStyle(key)}></i>)}
            </div>

            <div class="bx-layer bx-pcb" data-bx-part="pcb" style="--z:11px;--ze:118px;--delay:210ms">
              <div class="bx-circuit bx-circuit-a"></div>
              <div class="bx-circuit bx-circuit-b"></div>
              {keys.map((key) => <i class="bx-socket" style={keyStyle(key)}></i>)}
            </div>

            <div class="bx-layer bx-plate" data-bx-part="plate" style="--z:19px;--ze:172px;--delay:280ms">
              {keys.map((key) => <i class="bx-cutout" style={keyStyle(key)}></i>)}
            </div>

            <div class="bx-layer bx-switches" data-bx-part="switches" style="--z:28px;--ze:232px;--delay:350ms">
              {keys.map((key) => <i class="bx-switch" style={keyStyle(key)}><b></b></i>)}
            </div>

            <div class="bx-layer bx-keycaps" data-bx-part="keycaps" style="--z:46px;--ze:300px;--delay:420ms">
              {keys.map((key) => <i class="bx-model-key" style={keyStyle(key)}><span>{key.label}</span></i>)}
            </div>
          </div>

          <div class="bx-active-chip" data-bx-chip aria-live="polite">
            <b data-bx-chip-index>01</b>
            <span data-bx-chip-label>KEYCAPS</span>
            <i></i>
            <small data-bx-chip-spec>PBTfans Frontier · doubleshot PBT</small>
          </div>
          <span class="bx-view-readout" data-bx-readout>100% · 56° / -29°</span>
        </div>
        <p class="bx-hint">
          <span data-bx-photo-hint>{lang === 'es' ? 'Neo65 terminado · PBTfans Frontier · fotografía original' : 'Finished Neo65 · PBTfans Frontier · original photograph'}</span>
          <span data-bx-model-hint hidden>
            <span class="bx-hint-wide">{lang === 'es' ? 'Arrastra para orbitar · rueda para ampliar · doble clic para restablecer' : 'Drag to orbit · scroll to zoom · double-click to reset'}</span>
            <span class="bx-hint-narrow">{lang === 'es' ? 'Arrastra para orbitar · toca una pieza para aislarla' : 'Drag to orbit · tap a part to isolate'}</span>
          </span>
        </p>
      </div>

      <aside class="bx-specs">
        <span class="bx-kicker">BUILD 01 // ARCHIVE</span>
        <h5>Neo65</h5>
        <p>65% · Gasket mount · Wired hotswap</p>
        <div class="bx-parts-head">
          <span>{lang === 'es' ? 'Orden de montaje' : 'Assembly order'}</span>
          <span>{parts.length} {lang === 'es' ? 'piezas' : 'parts'}</span>
        </div>
        <ol class="bx-parts">
          {parts.map((part, index) => (
            <li>
              <button type="button" data-bx-part-button={part.id} aria-pressed="false">
                <span class="bx-part-index">{String(index + 1).padStart(2, '0')}</span>
                <i style={`--swatch:${part.color}`}></i>
                <span><strong>{part.label}</strong><small>{part.spec}</small></span>
              </button>
            </li>
          ))}
        </ol>
      </aside>
    </div>
  </div>
</div>

<style>
  .kb-build-explorer {
    container-type: inline-size;
    border: 1px solid var(--line);
    border-radius: .75rem;
    background: var(--ink-800);
    padding: clamp(1rem, 2.2vw, 1.5rem);
    box-shadow: 0 20px 45px -28px rgba(0, 0, 0, .9);
  }
  .kb-build-explorer[hidden], .bx-viewer[hidden], .bx-gallery[hidden] { display: none; }
  .bx-header, .bx-toolbar, .bx-card-copy, .bx-parts-head {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 1rem;
  }
  .bx-header { padding-bottom: .85rem; border-bottom: 1px solid var(--line-soft); }
  .bx-kicker {
    display: block;
    color: var(--cyan);
    font: 700 .66rem/1.2 var(--font-mono);
    letter-spacing: .12em;
  }
  .bx-header h4 { margin-top: .3rem; color: var(--fg); font-size: 1rem; font-weight: 700; }
  .bx-status {
    display: inline-flex;
    align-items: center;
    gap: .45rem;
    color: var(--fg-3);
    font: 500 .64rem/1 var(--font-mono);
    letter-spacing: .06em;
    white-space: nowrap;
  }
  .bx-status i { width: .35rem; height: .35rem; border-radius: 50%; background: var(--cyan); box-shadow: 0 0 10px rgba(111, 227, 255, .55); }
  .bx-gallery { padding-top: 1rem; }
  .bx-intro { max-width: 60ch; color: var(--fg-2); font-size: .82rem; line-height: 1.65; }
  .bx-build-card {
    display: block;
    width: 100%;
    margin-top: 1.15rem;
    overflow: hidden;
    border: 1px solid var(--line);
    border-radius: .6rem;
    background: var(--ink-950);
    color: inherit;
    text-align: left;
    cursor: pointer;
    transition: transform .35s cubic-bezier(.22, 1, .36, 1), border-color .3s ease, box-shadow .3s ease;
  }
  .bx-build-card:hover { transform: translateY(-3px); border-color: rgba(111, 227, 255, .45); box-shadow: 0 24px 48px -30px #000; }
  .bx-build-card:focus-visible, .bx-back:focus-visible, .bx-view-switch button:focus-visible, .bx-photo-nav:focus-visible, .bx-parts button:focus-visible { outline: 2px solid var(--cyan); outline-offset: 3px; }
  .bx-card-visual {
    position: relative;
    display: grid;
    place-items: center;
    aspect-ratio: 2.35 / 1;
    overflow: hidden;
    background: var(--ink-950);
  }
  .bx-card-visual::after { content: ''; position: absolute; inset: 0; z-index: 1; background: linear-gradient(180deg, rgba(5, 8, 15, .22), transparent 40%, rgba(5, 8, 15, .38)); pointer-events: none; }
  .bx-card-visual :global(img) { width: 100%; height: 100%; object-fit: cover; transition: transform .7s cubic-bezier(.22, 1, .36, 1), filter .4s ease; }
  .bx-build-card:hover .bx-card-visual :global(img) { transform: scale(1.025); filter: brightness(1.06); }
  .bx-card-index, .bx-card-authentic { position: absolute; z-index: 2; top: .75rem; font: 600 .58rem/1 var(--font-mono); letter-spacing: .12em; }
  .bx-card-index { left: .8rem; color: var(--fg); text-shadow: 0 1px 8px rgba(0, 0, 0, .85); }
  .bx-card-authentic { right: .8rem; display: inline-flex; align-items: center; gap: .4rem; padding: .38rem .5rem; border: 1px solid rgba(111, 227, 255, .35); border-radius: .3rem; background: rgba(5, 8, 15, .72); color: var(--cyan); backdrop-filter: blur(8px); }
  .bx-card-authentic i, .bx-photo-stage > span i { width: .3rem; height: .3rem; border-radius: 50%; background: var(--cyan); box-shadow: 0 0 8px rgba(111, 227, 255, .65); }
  .bx-model-key, .bx-cutout, .bx-socket, .bx-switch {
    position: absolute;
    left: calc(var(--x) + .35%);
    top: calc(var(--y) + 1.4%);
    width: calc(var(--w) - .7%);
    height: 17.2%;
  }
  .bx-preview-board i { border-radius: 2px; background: linear-gradient(155deg, #85887e, #595c55); box-shadow: inset 0 1px rgba(255, 255, 255, .22), 0 2px #41443d; }
  .bx-card-copy { padding: .8rem .9rem; border-top: 1px solid var(--line-soft); }
  .bx-card-copy > span:first-child { display: grid; gap: .2rem; }
  .bx-card-copy strong { color: var(--fg); font-size: .86rem; }
  .bx-card-copy small, .bx-specs > p { color: var(--fg-3); font: 400 .63rem/1.35 var(--font-mono); }
  .bx-inspect { color: var(--cyan); font: 600 .65rem/1 var(--font-mono); white-space: nowrap; }
  .bx-inspect b { display: inline-block; margin-left: .2rem; transition: transform .2s ease; }
  .bx-build-card:hover .bx-inspect b { transform: translateX(3px); }
  .bx-viewer { padding-top: .9rem; }
  .bx-back { border: 0; background: transparent; color: var(--fg-3); font: 600 .68rem/1 var(--font-mono); cursor: pointer; }
  .bx-back:hover { color: var(--fg); }
  .bx-view-switch { display: grid; grid-template-columns: repeat(3, auto); padding: .2rem; border: 1px solid var(--line); border-radius: .45rem; background: var(--ink-950); }
  .bx-view-switch button { min-height: 1.9rem; padding: .35rem .65rem; border: 0; border-radius: .28rem; background: transparent; color: var(--fg-3); font: 600 .61rem/1 var(--font-mono); cursor: pointer; transition: background .2s ease, color .2s ease, box-shadow .2s ease; }
  .bx-view-switch button:hover { color: var(--fg); }
  .bx-view-switch button[aria-pressed='true'] { background: var(--ink-700); color: var(--cyan); box-shadow: inset 0 0 0 1px rgba(111, 227, 255, .32); }
  .bx-workbench {
    display: grid;
    grid-template-columns: minmax(0, 1.45fr) minmax(14rem, .8fr);
    gap: clamp(1rem, 2.4vw, 1.7rem);
    margin-top: .85rem;
    padding: clamp(.75rem, 2vw, 1.25rem);
    border: 1px solid transparent;
    background: transparent;
  }
  .bx-stage-column { min-width: 0; }
  .bx-stage {
    position: relative;
    display: grid;
    place-items: center;
    height: 24rem;
    overflow: hidden;
    perspective: 1500px;
    perspective-origin: 50% 45%;
    touch-action: none;
    overscroll-behavior: contain;
    user-select: none;
    -webkit-user-select: none;
    cursor: grab;
    transition: height .7s cubic-bezier(.22, 1, .36, 1);
  }
  .bx-stage *, .bx-stage :global(img) { user-select: none; -webkit-user-select: none; -webkit-user-drag: none; }
  .bx-stage.is-dragging { cursor: grabbing; }
  .bx-stage.is-dragging .bx-layer { cursor: grabbing; }
  .bx-photo-stage { position: absolute; inset: .25rem; z-index: 4; display: grid; place-items: center; opacity: 0; visibility: hidden; transform: translateY(5px); transition: opacity .4s ease, transform .5s cubic-bezier(.22, 1, .36, 1), visibility .4s; }
  .bx-photo-frame { position: absolute; inset: 0; display: grid; place-items: center; width: min(88%, 44rem); height: 100%; margin-inline: auto; }
  .bx-photo-slides { align-self: start; width: 100%; height: calc(100% - 1.5rem); }
  .bx-photo-slide { width: 100%; height: 100%; }
  .bx-photo-slide { position: relative; margin: 0; overflow: hidden; }
  .bx-photo-slide[hidden] { display: none; }
  .bx-photo-frame :global(picture) { display: contents; }
  .bx-photo-stage :global(img) { position: absolute; inset: 0; display: block; width: 100%; height: 100%; object-fit: contain; }
  .bx-photo-meta { position: absolute; right: 0; bottom: .25rem; display: inline-flex; align-items: center; gap: .55rem; color: var(--fg-2); font: 600 .54rem/1 var(--font-mono); letter-spacing: .08em; }
  .bx-photo-meta b { padding-left: .55rem; border-left: 1px solid var(--line); color: var(--cyan); font: inherit; }
  .bx-photo-nav { position: absolute; z-index: 2; top: 50%; display: grid; place-items: center; width: 2rem; aspect-ratio: 1; border: 1px solid var(--line); border-radius: 50%; background: rgba(6, 10, 18, .72); color: var(--fg); font: 600 .9rem/1 var(--font-mono); cursor: pointer; backdrop-filter: blur(8px); transform: translateY(-50%); transition: border-color .2s ease, color .2s ease, background .2s ease; }
  .bx-photo-nav:hover { border-color: rgba(111, 227, 255, .55); background: rgba(6, 10, 18, .92); color: var(--cyan); }
  .bx-photo-prev { left: 0; }
  .bx-photo-next { right: 0; }
  .kb-build-explorer.is-photo-view .bx-photo-stage { opacity: 1; visibility: visible; transform: none; }
  .kb-build-explorer.is-photo-view .bx-model { opacity: 0; pointer-events: none; transform: translate(-50%, -50%) scale(.92) rotateX(var(--rx)) rotateZ(var(--rz)); }
  .kb-build-explorer.is-photo-view .bx-active-chip, .kb-build-explorer.is-photo-view .bx-view-readout { opacity: 0 !important; }
  .kb-build-explorer.is-photo-view .bx-stage { height: 22rem; cursor: default; }
  .bx-model {
    --rx: 56deg;
    --rz: -29deg;
    --fit: .64;
    --zoom: 1;
    --offset-y: 0px;
    position: absolute;
    left: 50%;
    top: 50%;
    width: 502px;
    height: 172px;
    transform-style: preserve-3d;
    transform: translate(-50%, calc(-50% + var(--offset-y))) scale(calc(var(--fit) * var(--zoom))) rotateX(var(--rx)) rotateZ(var(--rz));
    opacity: 1;
    transition: transform .5s cubic-bezier(.22, 1, .36, 1), opacity .35s ease;
  }
  .bx-stage.is-dragging .bx-model { transition: none; }
  .bx-floor { display: none; }
  .bx-layer {
    position: absolute;
    inset: 0;
    border-radius: 9px;
    transform-style: preserve-3d;
    transform: translateZ(var(--z));
    transition: transform .82s cubic-bezier(.32, 1.22, .4, 1), filter .25s ease, opacity .25s ease;
    transition-delay: var(--delay), 0ms, 0ms;
    cursor: pointer;
  }
  .kb-build-explorer.is-exploded .bx-stage { height: 32rem; }
  .kb-build-explorer.is-exploded .bx-model { --fit: .58; --offset-y: 42px; }
  .kb-build-explorer.is-exploded .bx-layer { transform: translateZ(var(--ze)); }
  .kb-build-explorer.is-exploded .bx-floor { transform: translateZ(-210px); }
