---
import Icon from '../Icon.astro'
import { formatDuration, formatPeriod, getExperience, getProjects } from '../../lib/content'
import { t, type Lang } from '../../i18n/ui'

interface Props { lang: Lang }
const { lang } = Astro.props

const experience = await getExperience(lang)
const projects = await getProjects(lang)

const now = experience.filter((e) => e.end === null)
const before = experience.filter((e) => e.end !== null)

/** Fichas profundas compartidas: no pertenecen a V1 ni a V2. */
const CASE_PATHS: Record<string, string> = { 'sars-cov-2': '/work/sars-cov-2/' }
const casePath = (key: string) =>
  CASE_PATHS[key] ? (lang === 'es' ? `/es${CASE_PATHS[key]}` : CASE_PATHS[key]) : null
---

<section id="work" class="mx-auto w-full max-w-6xl scroll-mt-24 px-5 py-20 sm:px-8 sm:py-28">
  <header class="reveal max-w-2xl">
    <p class="v2-eyebrow">02 — {t(lang, 'v2.work.title')}</p>
    <h2 class="v2-h2 mt-3">{t(lang, 'v2.work.lede')}</h2>
  </header>

  <div class="mt-12 grid gap-10 lg:grid-cols-[0.9fr_1.1fr] lg:gap-14">
    <!-- Trayectoria condensada: una línea por puesto, sin tarjetas -->
    <div>
      <h3 class="v2-eyebrow reveal">{t(lang, 'v2.work.now')}</h3>
      <ul class="mt-4 space-y-6">
        {
          now.map((item) => (
            <li class="reveal">
              <p class="text-lg font-semibold">{item.role}</p>
              <p class="mt-0.5 text-sm text-[var(--v2-accent-soft)]">{item.company}</p>
              <p class="mt-1 text-xs text-[var(--v2-fg-dim)]">
                {formatPeriod(item.start, item.end, lang)} · {formatDuration(item.start, item.end, lang)}
                {item.location && ` · ${item.location}`}
              </p>
              <p class="mt-3 text-sm leading-relaxed text-[var(--v2-fg-muted)]">{item.summary}</p>
              <ul class="mt-3 flex flex-wrap gap-1.5">
                {[...item.tech, ...item.practices].map((tag) => (
                  <li class="v2-chip">{tag}</li>
                ))}
              </ul>
            </li>
          ))
        }
      </ul>

      <h3 class="v2-eyebrow reveal mt-12">{t(lang, 'v2.work.before')}</h3>
      <ul class="mt-4 space-y-4">
        {
          before.map((item, i) => (
            <li class="reveal flex flex-wrap items-baseline justify-between gap-x-4 gap-y-1 border-t border-[var(--v2-line-soft)] pt-4" style={`--i:${i}`}>
              <div>
                <span class="text-sm font-medium">{item.role}</span>
                <span class="ml-2 text-sm text-[var(--v2-fg-dim)]">{item.company}</span>
              </div>
              <span class="text-xs tabular-nums text-[var(--v2-fg-dim)]">
                {formatPeriod(item.start, item.end, lang)}
              </span>
            </li>
          ))
        }
      </ul>
    </div>

    <!-- Proyectos -->
    <div>
      <h3 class="v2-eyebrow reveal">{t(lang, 'v2.work.projects')}</h3>
      <ul class="mt-4 space-y-4">
        {
          projects.map((p, i) => {
            const href = casePath(p.key)
            return (
              <li class="reveal" style={`--i:${i}`}>
                <article class="v2-card v2-card-hover p-5 sm:p-6">
                  <div class="flex flex-wrap items-start justify-between gap-3">
                    <div>
                      <p class="text-[0.66rem] uppercase tracking-[0.24em] text-[var(--v2-fg-dim)]">{p.eyebrow}</p>
                      <h4 class="mt-1.5 text-lg font-semibold">{p.title}</h4>
                    </div>
                    <span class:list={['v2-chip shrink-0', p.badge === 'live' && 'v2-chip-accent']}>
                      {t(lang, p.badge === 'live' ? 'work.badge.live' : 'work.badge.private')}
                    </span>
                  </div>

                  <p class="mt-3 text-sm leading-relaxed text-[var(--v2-fg-muted)]">{p.description}</p>

                  <ul class="mt-4 flex flex-wrap gap-1.5">
                    {[...p.tech, ...p.domains].map((tech) => (
                      <li class="v2-chip">{tech}</li>
                    ))}
                  </ul>

                  {(href || p.link) && (
                    <p class="mt-5 flex flex-wrap gap-x-5 gap-y-2 text-sm">
                      {href && (
                        <a href={href} class="inline-flex items-center gap-1.5 font-medium text-[var(--v2-accent-soft)] hover:text-[var(--v2-accent)]">
                          {t(lang, 'v2.work.case')}
                          <Icon name="arrowUpRight" class="h-3.5 w-3.5" />
                        </a>
                      )}
                      {p.link && (
                        <a
                          href={p.link}
                          target="_blank"
                          rel="noopener noreferrer"
                          class="inline-flex items-center gap-1.5 text-[var(--v2-fg-muted)] hover:text-[var(--v2-fg)]"
                        >
                          {t(lang, 'v2.work.visit')}
                          <Icon name="external" class="h-3.5 w-3.5" />
                        </a>
                      )}
                    </p>
                  )}
                </article>
              </li>
            )
          })
        }
      </ul>
    </div>
  </div>
</section>
