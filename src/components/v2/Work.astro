---
/**
 * Career area: the timeline of roles and the project carousel.
 *
 * The carousel's covers are 2000 px screenshots and the viewer never exceeds
 * ~1100 px, so they are served resized and in AVIF/WebP. The original PNG stays
 * as the fallback, at high quality so the screenshot's thin lines and text do
 * not get muddy.
 *
 * They stay lazy on first paint so they do not fight the hero. The boot warms
 * every cover as soon as #work is close — paging used to wait on a download
 * that only started on the arrow, and that wait is visible. Priority stays low
 * so the cover on screen still wins the connection.
 */
import { Picture } from 'astro:assets'
import Icon from '../Icon.astro'
import TechChip from './TechChip.astro'
import { casePath, formatDuration, formatPeriod, getExperience, getProjects, projectRepos } from '../../lib/content'
import { V2_ANCHOR_ALIASES, t, type Lang, type UiKey } from '../../i18n/ui'

interface Props { lang: Lang }
const { lang } = Astro.props

const experience = await getExperience(lang)
const projects = await getProjects(lang)
const featuredProjects = projects.filter((project) => project.featured)
const otherProjects = projects.filter((project) => !project.featured)

/**
 * A project's status label. As a map and not as a chain of ternaries: if the
 * schema accepts one more status tomorrow, the index stops compiling instead of
 * quietly falling through to the last branch.
 */
const BADGE_LABELS: Record<'live' | 'private' | 'coming-soon', UiKey> = {
  live: 'work.badge.live',
  private: 'work.badge.private',
  'coming-soon': 'work.comingSoon',
}

const badgeLabel = (badge: keyof typeof BADGE_LABELS) => t(lang, BADGE_LABELS[badge])
const caseLink = (projectKey: string, origin: 'project-carousel' | 'project-deck') => {
  const path = casePath(projectKey, lang)
  return path ? `${path}?from=${origin}` : null
}
---

<section id="work" class="band">
  {(V2_ANCHOR_ALIASES['work'] ?? []).map((a) => <span id={a} class="anchor-alias" aria-hidden="true" />)}

  <div class="shell">
    <!-- Unified section 01 header -->
    <header class="rule-head reveal">
      <span class="t-index">01</span>
      <h2 class="t-h2">{t(lang, 'v2.work.title')}</h2>
    </header>

    <!-- ══════════ 1. PROFESSIONAL EXPERIENCE TABS (GAZI-V2 STYLE) ══════════ -->
    <div class="reveal mt-10 sm:mt-14" style="--i:1">
      <div class="grid grid-cols-1 lg:grid-cols-12 gap-8 items-start">
        <!-- Left column: tab list / companies -->
        <div class="lg:col-span-4">
          <p class="t-meta text-[color:var(--fg-3)] mb-4">{t(lang, 'v2.work.timeline')}</p>
          <div id="job-tabs" class="job-tabs relative flex flex-row lg:flex-col overflow-x-auto lg:overflow-visible pb-2 lg:pb-0 rounded-xl bg-[color:var(--ink-800)]/60 border border-[color:var(--line-soft)] p-1.5" role="tablist" aria-label={t(lang, 'a11y.jobTabs')}>
            <span id="job-indicator" class="job-indicator" aria-hidden="true" />
            {experience.map((item, i) => (
              <button
                type="button"
                role="tab"
                class={`job-tab rounded-lg ${i === 0 ? 'is-active' : ''}`}
                id={`job-tab-${i}`}
                data-tab-index={i}
                aria-selected={i === 0 ? 'true' : 'false'}
                aria-controls={`job-panel-${i}`}
              >
                <span class="job-tab-company block font-bold text-sm text-[color:var(--fg)]">{item.company}</span>
                <span class="job-tab-role block text-xs text-[color:var(--fg-3)] mt-0.5 truncate">{item.role}</span>
              </button>
            ))}
          </div>
        </div>

        <!-- Right column: detail panel for the active role -->
        <div class="lg:col-span-8">
          <div id="job-panels" class="relative min-h-0 sm:min-h-[320px] rounded-2xl border border-[color:var(--line)] bg-[color:var(--ink-800)] p-5 sm:p-8 shadow-xl">
            {experience.map((item, i) => (
              <div
                class={`job-panel ${i === 0 ? 'is-active' : ''}`}
                id={`job-panel-${i}`}
                role="tabpanel"
                aria-labelledby={`job-tab-${i}`}
                data-panel-index={i}
              >
                <div class="flex flex-wrap items-start justify-between gap-2 border-b border-[color:var(--line-soft)] pb-4">
                  <div>
                    <h3 class="text-xl sm:text-2xl font-bold tracking-tight text-[color:var(--fg)]">
                      {item.role} <span class="text-[color:var(--blue-bright)] font-mono">@ {item.company}</span>
                    </h3>
                    <p class="t-meta mt-1 text-xs sm:text-sm text-[color:var(--fg-3)]">
                      {formatPeriod(item.start, item.end, lang)} · <span class="text-[color:var(--fg-2)]">{formatDuration(item.start, item.end, lang)}</span>
                    </p>
                  </div>
                  {item.mode && (
                    <span class="t-meta rounded-full border border-[color:var(--line)] bg-[color:var(--ink-700)] px-3 py-1 text-xs text-[color:var(--fg-2)]">
                      {item.mode}
                    </span>
                  )}
                </div>

                <p class="t-body mt-5 text-sm sm:text-base leading-relaxed text-[color:var(--fg-2)]">
                  {item.summary}
                </p>

                {item.bullets && item.bullets.length > 0 && (
                  <ul class="mt-4 space-y-2">
                    {item.bullets.map((b) => (
                      <li class="flex items-start gap-2.5 text-sm text-[color:var(--fg-2)] leading-relaxed">
                        <span class="mt-1.5 flex h-1.5 w-1.5 shrink-0 rounded-full bg-[color:var(--blue-bright)]" aria-hidden="true" />
                        <span>{b}</span>
                      </li>
                    ))}
                  </ul>
                )}

                <ul class="mt-6 flex flex-wrap gap-1.5 border-t border-[color:var(--line-soft)] pt-4">
                  {[...item.tech, ...item.practices].map((tag) => (
                    <li><TechChip tag={tag} lang={lang} /></li>
                  ))}
                </ul>
              </div>
            ))}
          </div>
        </div>
      </div>
    </div>

    <!-- ══════════ 2. PROJECTS SPOTLIGHT CAROUSEL (SOFTWARE SHOWCASE STYLE) ══════════ -->
    <div class="reveal mt-16 sm:mt-24" style="--i:2">
      <div class="flex flex-wrap items-center justify-between mb-6 gap-4 border-b border-[color:var(--line-soft)] pb-4">
        <div>
          <span class="font-mono text-xs text-[color:var(--cyan)] font-bold tracking-wider uppercase">01.2 // {t(lang, 'v2.work.showcase')}</span>
          <h3 class="t-h3 text-[color:var(--fg)] mt-1">{t(lang, 'v2.work.carousel')}</h3>
        </div>
        <a
          href="https://github.com/rubenmtzb"
          target="_blank"
          rel="noopener noreferrer"
          class="group inline-flex items-center gap-1.5 font-mono text-xs text-[color:var(--fg-2)] hover:text-[color:var(--cyan)] transition"
        >
          <span>{t(lang, 'v2.work.viewAllGithub')}</span>
          <span class="transition-transform group-hover:translate-x-1">→</span>
        </a>
      </div>

      <!-- Projects carousel container: the real cover behind, text laid over it -->
      <div
        id="project-carousel"
        class="project-carousel relative overflow-hidden rounded-3xl border border-[color:var(--line)] bg-[color:var(--ink-900)] shadow-2xl"
        role="region"
        aria-roledescription={t(lang, 'v2.work.carouselRole')}
        aria-label={t(lang, 'v2.work.carousel')}
        tabindex="0"
      >
        {featuredProjects.map((p, i) => (
          <article
            class={`project-slide group relative w-full flex-col ${i === 0 ? 'is-active' : ''}`}
            data-slide-index={i}
            data-project={p.key}
            role="group"
            aria-roledescription={t(lang, 'v2.work.slideRole')}
            aria-label={`${i + 1} / ${featuredProjects.length}: ${p.title}`}
          >
            <div class="relative w-full aspect-[4/3] sm:aspect-[2/1]">
            {p.image ? (
              <Picture
                src={p.image}
                formats={['avif', 'webp']}
                fallbackFormat="png"
                quality={90}
                widths={[640, 896, 1104, 1200, 1600]}
                width={1600}
                sizes="(max-width: 1216px) calc(100vw - 2rem), 1104px"
                alt={p.imageAlt || `${p.title} — ${t(lang, 'v2.work.cover')}`}
                loading="lazy"
                fetchpriority="low"
                decoding="async"
                class="project-cover absolute inset-0 h-full w-full object-cover"
              />
            ) : (
              <div class="project-coming-soon absolute inset-0 flex items-center justify-center" aria-hidden="true">
                <div class="text-center">
                  <span class="font-mono text-[0.65rem] uppercase tracking-[0.32em] text-[color:var(--cyan)]">00 / 01</span>
                  <p class="mt-3 font-mono text-lg font-bold uppercase tracking-[0.18em] text-[color:var(--fg)]">{t(lang, 'v2.work.underConstruction')}</p>
                  <span class="mt-3 inline-block h-px w-28 bg-[color:var(--cyan)]/60"></span>
                </div>
              </div>
            )}

            <div class="project-pointer-light pointer-events-none absolute inset-0" aria-hidden="true" />

            <!-- Local scrim: preserves the image and shields only the areas holding text. -->
            <div class="project-cover-scrim pointer-events-none absolute inset-0" />

            <!-- Real text (SEO/a11y) laid over it, composed like the cover -->
            <div class="project-overlay absolute inset-0 z-10 flex flex-col justify-between p-3 sm:p-8 md:p-10">
              <!-- Fila superior: estado + tipo de proyecto -->
              <div class="project-meta flex items-center gap-3">
                <span class={`rounded-md border px-2 py-0.5 font-mono text-[0.6rem] sm:text-[0.65rem] uppercase tracking-[0.18em] ${p.badge === 'live' ? 'border-[color:var(--live-strong)]/40 text-[color:var(--live)]' : p.badge === 'coming-soon' ? 'border-[color:var(--pending-line)]/40 text-[color:var(--pending-soft)]' : 'border-[color:var(--blue-bright)]/50 text-[color:var(--blue-bright)]'}`}>
                  {badgeLabel(p.badge)}
                </span>
                <span class="font-mono text-[0.6rem] sm:text-[0.65rem] uppercase tracking-[0.22em] text-[color:var(--fg-3)]">
                  {p.eyebrow}
                </span>
              </div>

              <!-- Bottom row: large title, inline stack and actions -->
              <div class="project-bottom flex items-end justify-between gap-3 sm:gap-8">
                <div class="min-w-0 flex-1">
                  <h4 class="project-cover-title max-w-[26ch] text-xl sm:text-4xl md:text-5xl font-extrabold tracking-tight leading-[1.05] text-white drop-shadow-[0_2px_12px_rgb(var(--scrim)_/_0.7)]">
                    {p.title.split(' ').map((word) => <span class="mr-[0.22em] inline-block whitespace-nowrap">{word}</span>)}
                  </h4>
                  <ul class="project-cover-tech hidden lg:flex mt-3 flex-wrap gap-1.5">
                    {[...p.tech, ...p.domains].map((tag) => (
                      <li><TechChip tag={tag} lang={lang} /></li>
                    ))}
                  </ul>
                </div>

              </div>
            </div>
            </div>
            <div class="border-t border-[color:var(--line-soft)] bg-[color:var(--ink-900)] p-5 sm:px-8 sm:py-6">
              <p class="max-w-3xl text-sm leading-relaxed text-[color:var(--fg-2)]">{p.description}</p>
              <div class="project-actions" role="group" aria-label={t(lang, 'v2.work.actions')}>
                {projectRepos(p.github).length > 0 && (
                  <div class="project-source">
                    <span class="project-source-brand"><Icon name="github" class="h-6 w-6" /><span>GitHub<small>{t(lang, 'v2.work.source')}</small></span></span>
                    <div class="project-source-links">
                      {projectRepos(p.github).map((repo) => (
                        <a href={repo.href} target="_blank" rel="noopener noreferrer" class="project-repo-link" aria-label={`${t(lang, 'a11y.repo')}: ${repo.label}`}>
                          <span>{repo.label}</span><Icon name="arrowUpRight" class="h-3 w-3" />
                        </a>
                      ))}
                    </div>
                  </div>
                )}
                {p.badge === 'private' && (
                  <span class="project-private-source"><Icon name="lock" class="h-5 w-5" />{t(lang, 'v2.work.privateCode')}</span>
                )}
                <div class="project-action-links">
                  {caseLink(p.key, 'project-carousel') && (
                    <a href={caseLink(p.key, 'project-carousel')!} data-case-origin="project-carousel" class="project-action project-action-case">
                      <span class="project-action-icon"><Icon name="eye" class="h-5 w-5" /></span>
                      <span><small>{t(lang, 'v2.work.details')}</small><strong>{t(lang, 'v2.work.case')}</strong></span>
                      <Icon name="arrowUpRight" class="project-action-arrow h-4 w-4" />
                    </a>
                  )}
                  {p.link && (
                    <a href={p.link} target="_blank" rel="noopener noreferrer" class="project-action project-action-demo" aria-label={`${t(lang, 'v2.work.app')}: ${p.title}`}>
                      <span class="project-action-icon"><Icon name="play" class="h-5 w-5" /></span>
                      <span><small>{t(lang, 'v2.work.visit')}</small><strong>{t(lang, 'v2.work.app')}</strong></span>
                      <Icon name="external" class="project-action-arrow h-4 w-4" />
                    </a>
                  )}
                  {p.publication && (
                    <a href={p.publication.href} target="_blank" rel="noopener noreferrer" class="project-action project-action-paper">
                      <span class="project-action-icon"><Icon name="book" class="h-5 w-5" /></span>
                      <span><small>MDPI / IJMS</small><strong>{t(lang, 'v2.work.paper')}</strong></span>
                      <Icon name="external" class="project-action-arrow h-4 w-4" />
                    </a>
                  )}
                </div>
              </div>
            </div>
          </article>
        ))}

        <!-- Side buttons; on mobile the touch gesture leaves the image completely clear. -->
        <button
          type="button"
          id="proj-prev"
          class="proj-nav-arrow proj-prev-arrow hidden sm:flex"
          aria-label={t(lang, 'v2.work.previousProject')}
        >
          ‹
        </button>
        <button
          type="button"
          id="proj-next"
          class="proj-nav-arrow proj-next-arrow hidden sm:flex"
          aria-label={t(lang, 'v2.work.nextProject')}
        >
          ›
        </button>

        <!-- Indicators at the top right: they compete with neither title, stack nor actions. -->
        <div class="project-pagination absolute right-3 top-3 sm:right-8 sm:top-8 z-20 flex items-center gap-1.5 sm:gap-2" id="proj-dots">
          {featuredProjects.map((_, i) => (
            <button
              type="button"
              class={`proj-bar-indicator ${i === 0 ? 'is-active' : ''}`}
              data-dot-index={i}
              aria-label={`${t(lang, 'v2.work.goToProject')} ${i + 1}`}
              aria-current={i === 0 ? 'true' : 'false'}
            />
          ))}
        </div>
      </div>
    </div>

    {otherProjects.length > 0 && (
      <div id="project-deck" class="project-references reveal" style="--i:3">
        {otherProjects.map((p) => (
          <div data-project={p.key} class="project-reference">
            <p><strong>{p.title}</strong><span>{p.tech.join(' / ')}</span></p>
            {projectRepos(p.github).map((repo) => (
              <a href={repo.href} target="_blank" rel="noopener noreferrer" aria-label={`${t(lang, 'v2.work.source')}: ${p.title} / ${repo.label}`}>
                <Icon name="github" class="h-4 w-4" />
                <span>{t(lang, 'v2.work.source')}</span>
                <Icon name="arrowUpRight" class="h-3.5 w-3.5" />
              </a>
            ))}
          </div>
        ))}
      </div>
    )}
  </div>
</section>
