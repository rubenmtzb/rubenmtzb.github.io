---
import { ANCHOR_ALIASES } from '../../i18n/ui'

interface Props {
  id: string
  title: string
  class?: string
}
const { id, title, class: className = '' } = Astro.props
const aliases = ANCHOR_ALIASES[id] ?? []
---

<section id={id} class={`relative overflow-hidden px-4 py-16 sm:px-6 sm:py-20 ${className}`}>
  {/* Anclas heredadas de las 10 superficies anteriores: destino invisible
      para que ningún enlace entrante existente quede sin sitio. */}
  {aliases.map((alias) => <span id={alias} class="anchor-alias" aria-hidden="true" />)}

  <div class="relative mx-auto max-w-6xl">
    <h2 class="reveal mb-12 text-center text-2xl font-extrabold uppercase tracking-widest text-white text-glow-green sm:text-3xl">
      <span class="text-green-400">&gt; </span>{title}
    </h2>
    <slot />
  </div>
</section>

<div class="h-px bg-gradient-to-r from-transparent via-green-500/15 to-transparent" aria-hidden="true"></div>
