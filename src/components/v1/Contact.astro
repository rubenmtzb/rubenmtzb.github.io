---
import Section from './Section.astro'
import Icon from '../Icon.astro'
import { getProfile } from '../../lib/content'
import { t, type Lang } from '../../i18n/ui'

interface Props { lang: Lang }
const { lang } = Astro.props

const profile = await getProfile(lang)
const cvPath = lang === 'es' ? '/es/cv/' : '/cv/'
const pdfHref = lang === 'es' ? '/cv/CV_RubenMartinez_ES.pdf' : '/cv/CV_RubenMartinez_EN.pdf'

/** Los métodos salen de profile: no se repiten enlaces dentro de la sección. */
const methods = [
  { label: t(lang, 'contact.email'), display: profile.email, href: `mailto:${profile.email}`, icon: 'mail' as const, desc: t(lang, 'contact.emailDesc') },
  ...profile.socials.map((s) => ({
    label: s.label,
    display: s.href.replace(/^https?:\/\/(www\.)?/, '').replace(/\/$/, ''),
    href: s.href,
    icon: (s.label === 'LinkedIn' ? 'linkedin' : 'github') as 'linkedin' | 'github',
    desc: s.label === 'LinkedIn' ? t(lang, 'contact.linkedinDesc') : t(lang, 'contact.githubDesc'),
  })),
]
---

<Section id="contact" title={t(lang, 'contact.title')}>
  <div class="flex flex-col items-center text-center">
    <p class="reveal max-w-3xl text-3xl font-bold text-white sm:text-4xl">{profile.contactHeadline}</p>
    <p class="reveal mt-5 max-w-2xl text-base leading-7 text-slate-300 sm:text-lg" style="--i:1">{profile.contactSubheadline}</p>

    <ul class="mt-12 grid w-full gap-6 md:grid-cols-3">
      {
        methods.map((m, i) => (
          <li>
            <a
              href={m.href}
              target={m.href.startsWith('http') ? '_blank' : undefined}
              rel={m.href.startsWith('http') ? 'noopener noreferrer' : undefined}
              class="reveal group flex h-full flex-col rounded-xl border border-green-500/20 bg-black/40 p-6 text-left backdrop-blur-sm transition hover:-translate-y-1 hover:border-green-500/40"
              style={`--i:${i}`}
            >
              <div class="mb-5 flex items-center justify-between">
                <span class="flex h-12 w-12 items-center justify-center rounded-full border border-green-500/30 bg-green-500/10 text-green-300">
                  <Icon name={m.icon} class="h-5 w-5" />
                </span>
                <Icon name="external" class="h-4 w-4 text-dim transition group-hover:-translate-y-0.5" />
              </div>
              <p class="mb-2 text-xs uppercase tracking-[0.3em] text-dim">{m.label}</p>
              <p class="mb-3 break-all text-lg font-semibold text-white">{m.display}</p>
              <p class="text-sm leading-6 text-slate-300">{m.desc}</p>
            </a>
          </li>
        ))
      }
    </ul>

    <a
      href={`mailto:${profile.email}`}
      class="reveal mt-12 inline-flex items-center gap-3 rounded-full bg-gradient-to-r from-green-400 via-emerald-400 to-lime-300 px-8 py-4 text-base font-semibold text-slate-950 shadow-[0_0_30px_rgba(0,255,136,0.28)] transition hover:shadow-[0_0_45px_rgba(0,255,136,0.4)]"
    >
      <Icon name="send" class="h-5 w-5" />
      {t(lang, 'contact.send')}
    </a>

    {/* Resume deja de ser sección: pasa a recurso y CTA hacia /cv/. */}
    <div class="reveal mt-14 w-full rounded-2xl border border-green-500/20 bg-black/40 p-6 text-left backdrop-blur-sm sm:p-8">
      <div class="flex flex-col gap-6 sm:flex-row sm:items-center sm:justify-between">
        <div>
          <h3 class="text-xl font-bold text-white sm:text-2xl">{t(lang, 'contact.cvTitle')}</h3>
          <p class="mt-2 max-w-xl text-sm leading-6 text-slate-300/90">{t(lang, 'contact.cvDesc')}</p>
        </div>
        <div class="flex shrink-0 flex-col gap-3 sm:flex-row">
          <a
            href={pdfHref}
            download
            class="inline-flex items-center justify-center gap-2 rounded-full border border-green-300/45 bg-green-500/15 px-6 py-3 text-sm font-semibold text-green-100 transition hover:border-green-200/60 hover:bg-green-500/20"
          >
            <Icon name="download" class="h-4 w-4" />
            {t(lang, 'contact.cvDownload')}
          </a>
          <a
            href={cvPath}
            class="inline-flex items-center justify-center gap-2 rounded-full border border-green-400/30 px-6 py-3 text-sm font-semibold text-green-200 transition hover:border-green-300/45 hover:bg-green-500/10"
          >
            <Icon name="eye" class="h-4 w-4" />
            {t(lang, 'contact.cvPreview')}
          </a>
        </div>
      </div>
    </div>
  </div>
</Section>
