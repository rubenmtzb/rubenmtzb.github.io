---
import Section from './Section.astro'
import Icon from '../Icon.astro'
import { formatMonthYear, getCerts, getEducation, getProfile } from '../../lib/content'
import { t, type Lang } from '../../i18n/ui'
import { localizedTerm } from '../../i18n/terms'

interface Props { lang: Lang }
const { lang } = Astro.props

const education = await getEducation(lang)
const certs = await getCerts(lang)
const profile = await getProfile(lang)
---

<Section id="background" title={t(lang, 'background.title')}>
  <h3 class="reveal mb-8 text-center text-xs font-semibold uppercase tracking-[0.35em] text-green-300/85">
    {t(lang, 'background.education')}
  </h3>

  <ul class="mb-16 grid gap-6 md:grid-cols-2">
    {
      education.map((item, index) => (
        <li>
          <article class="reveal relative h-full overflow-hidden rounded-xl border border-green-500/20 bg-black/40 p-6 backdrop-blur-sm" style={`--i:${index}`}>
            <div class="absolute inset-x-0 top-0 h-px bg-gradient-to-r from-transparent via-green-400/80 to-cyan-400/60" aria-hidden="true" />

            <span class="inline-flex items-center gap-2 rounded-full border border-green-500/30 bg-green-500/10 px-3 py-1 text-xs uppercase tracking-[0.25em] text-green-300">
              <Icon name="graduation" class="h-3.5 w-3.5" />
              {item.institution}
            </span>

            <h4 class="mt-3 text-xl font-semibold leading-8 text-white">{item.title}</h4>

            <div class="mt-4 flex flex-wrap gap-3 text-xs text-gray-300">
              <span class="inline-flex items-center gap-2 rounded-full border border-green-500/20 bg-black/40 px-3 py-1.5">
                <Icon name="calendar" class="h-3.5 w-3.5 text-green-400" />
                {item.periodLabel}
              </span>
              {item.inProgress && (
                <span class="inline-flex items-center gap-2 rounded-full border border-green-500/30 bg-green-500/10 px-3 py-1.5 text-green-300">
                  <span class="pulse-dot inline-block h-2 w-2 rounded-full bg-green-400" aria-hidden="true" />
                  {t(lang, 'background.inProgress')}
                </span>
              )}
              {item.grade && (
                <span class="inline-flex items-center rounded-full border border-purple-400/30 bg-purple-400/10 px-3 py-1.5 text-purple-200">
                  {t(lang, 'background.grade')}: {item.grade}
                </span>
              )}
            </div>

            {item.description && <p class="mt-4 leading-7 text-gray-300">{item.description}</p>}

            {item.tags.length > 0 && (
              <ul class="mt-5 flex flex-wrap gap-2">
                {item.tags.map((tag) => (
                  <li class="rounded-full border border-green-500/30 bg-green-500/10 px-3 py-1 text-xs text-green-300">{localizedTerm(tag, lang)}</li>
                ))}
              </ul>
            )}

            {/* The verifiable credential belongs here: INESEM stops being duplicated
                between education and certifications. */}
            {item.credential && (
              <a
                href={item.credential.verifyUrl}
                target="_blank"
                rel="noopener noreferrer"
                class="mt-5 inline-flex items-center gap-1.5 text-xs font-medium text-green-300 transition hover:text-green-100"
              >
                {t(lang, 'background.verify')}
                <Icon name="external" class="h-3.5 w-3.5" />
              </a>
            )}
          </article>
        </li>
      ))
    }
  </ul>

  <h3 class="reveal mb-8 text-center text-xs font-semibold uppercase tracking-[0.35em] text-green-300/85">
    {t(lang, 'background.certifications')}
  </h3>

  <ul class="mb-16 grid gap-5 md:grid-cols-2 xl:grid-cols-3">
    {
      certs.map((cert, index) => (
        <li>
          <article class="reveal relative h-full overflow-hidden rounded-xl border border-green-500/20 bg-black/40 p-5 backdrop-blur-sm" style={`--i:${index}`}>
            <div class="absolute inset-x-0 top-0 h-1 bg-gradient-to-r from-green-400 via-cyan-400 to-purple-400" aria-hidden="true" />

            <div class="flex items-start justify-between gap-4">
              <div>
                <p class="text-[0.7rem] uppercase tracking-[0.3em] text-dim">{t(lang, 'background.issuedBy')}</p>
                <p class="mt-1 text-sm font-medium text-green-200">{cert.issuer}</p>
              </div>
              <span class="rounded-full border border-green-500/20 bg-green-500/10 p-2 text-green-300">
                <Icon name="award" class="h-4 w-4" />
              </span>
            </div>

            <h4 class="mt-5 text-xl font-bold text-white">{cert.title}</h4>

            <dl class="mt-4 space-y-1.5 text-sm text-slate-300/85">
              <div class="flex gap-2">
                <dt class="text-dim">{t(lang, 'background.date')}:</dt>
                <dd>{formatMonthYear(cert.date, lang)}</dd>
              </div>
              {cert.credentialId && (
                <div class="flex gap-2">
                  <dt class="text-dim">{t(lang, 'background.id')}:</dt>
                  <dd class="break-all">{cert.credentialId}</dd>
                </div>
              )}
            </dl>

            <div class="mt-5 flex flex-wrap items-center gap-4 text-xs font-medium">
              <a href={cert.verifyUrl} target="_blank" rel="noopener noreferrer" class="inline-flex items-center gap-1.5 text-green-300 transition hover:text-green-100">
                {t(lang, 'background.verify')}
                <Icon name="external" class="h-3.5 w-3.5" />
              </a>
              {cert.projectUrl && (
                <a href={cert.projectUrl} target="_blank" rel="noopener noreferrer" class="inline-flex items-center gap-1.5 text-green-300/85 transition hover:text-green-100">
                  {t(lang, 'background.project')}
                  <Icon name="external" class="h-3.5 w-3.5" />
                </a>
              )}
            </div>

            <ul class="mt-5 flex flex-wrap gap-2">
              {cert.tags.map((tag) => (
                <li class="rounded-full border border-green-500/30 bg-green-500/10 px-3 py-1 text-xs text-green-300">{localizedTerm(tag, lang)}</li>
              ))}
            </ul>
          </article>
        </li>
      ))
    }
  </ul>

  <h3 class="reveal mb-8 text-center text-xs font-semibold uppercase tracking-[0.35em] text-green-300/85">
    {t(lang, 'background.languages')}
  </h3>

  <ul class="reveal mx-auto flex max-w-3xl flex-wrap justify-center gap-4">
    {
      profile.languages.map((l) => (
        <li class="inline-flex items-center gap-3 rounded-xl border border-green-500/20 bg-black/40 px-5 py-3">
          <Icon name="languages" class="h-4 w-4 text-green-400" />
          <span class="text-sm font-semibold text-white">{l.name}</span>
          <span class="text-xs text-dim">{l.level}</span>
        </li>
      ))
    }
  </ul>
</Section>
