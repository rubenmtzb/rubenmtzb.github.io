---
import Icon from './Icon.astro'
import CaseDemo from './CaseDemo.astro'
import TechChip from './v2/TechChip.astro'
import { getExperience, getProjects, formatPeriod, localePath, projectRepos } from '../lib/content'
import { t, type Lang } from '../i18n/ui'
import '../styles/case-study.css'

/**
 * In-depth case study.
 *
 * It shares a stylesheet with the V2, so it speaks the V2's vocabulary: the
 * --ink/--line/--fg tokens and the t-* typographic classes. The stack chips are
 * the same component as on the home page, not a parallel pill that could drift
 * in colour or in destination.
 */
interface Props { lang: Lang; projectKey: string }
const { lang, projectKey } = Astro.props

const project = (await getProjects(lang)).find((p) => p.key === projectKey)
if (!project) throw new Error(`Case study: no such project "${projectKey}"`)

/** The role it was built from, where there was one. */
const role = (await getExperience(lang)).find((e) => e.company === project.deep?.partnerName)
/**
 * Back to the home page.
 *
 * The case study is linked from two places — the featured carousel and the grid
 * — and each announces itself with `?from=`. That parameter cannot be read while
 * generating the page: the site is static and the case study is rendered once,
 * so the built link points at the career area, which is correct whichever place
 * the visitor came from. The script below refines it in the browser, where the
 * parameter does exist; without JavaScript the link still leads somewhere right.
 */
const backPath = localePath('/#work', lang)

/** The two accepted origins, already resolved to the page's language. */
const BACK_TARGETS = {
  'project-carousel': localePath('/#project-carousel', lang),
  'project-deck': localePath('/#project-deck', lang),
}

const CARD = 'rounded-xl border border-[color:var(--line)] bg-[color:var(--ink-800)] p-5'
const CARD_LABEL = 't-meta text-[0.62rem] text-[color:var(--fg-3)]'
const isTranscriber = projectKey === 'youtube-transcriber'
const isMutation = projectKey === 'sars-cov-2'
const isFinance = projectKey === 'financial-architecture'
const isEditorial = isTranscriber || isMutation || isFinance
const demo = project.caseStudy?.demo ?? project.deep?.demo
const titleBrand = isMutation ? project.title.replace('SARS-CoV-2', '').trim() : project.title.split(' ')[0]
const titleAccent = isMutation ? 'SARS-CoV-2' : project.title.split(' ').slice(1).join(' ')
const flowKeys = isMutation
  ? ['v2.mutation.source', 'v2.mutation.process', 'v2.mutation.output'] as const
  : isFinance ? ['v2.finance.source', 'v2.finance.process', 'v2.finance.output'] as const
  : ['v2.case.source', 'v2.case.transcript', 'v2.case.translation'] as const
const researchIcons = ['dna', 'network', 'chart', 'book'] as const
const wave = [20, 32, 48, 30, 60, 78, 48, 92, 66, 42, 80, 100, 68, 44, 88, 58, 36, 70, 48, 28, 42, 24]
---

<article class:list={['mx-auto w-full max-w-3xl px-5 pb-24 pt-28 sm:px-8 sm:pt-36', { 'editorial-case': isEditorial, 'transcriber-case': isTranscriber, 'mutation-case': isMutation, 'finance-case': isFinance }]}>
  <a id="case-back" href={backPath} class="inline-flex items-center gap-2 text-sm text-[color:var(--fg-3)] transition hover:text-[color:var(--fg)]">
    <Icon name="arrowLeft" class="h-4 w-4" />
    {t(lang, 'v2.case.back')}
  </a>

  <header class:list={{ 'case-hero reveal': isEditorial }}>
  <div class:list={{ 'case-hero-grid': isEditorial }}>
  <div class:list={{ 'case-hero-copy': isEditorial }}>
  <p class:list={['t-meta mt-8 text-[color:var(--blue-bright)]', { 'case-eyebrow': isEditorial }]}>{isMutation && <Icon name="microscope" class="h-4 w-4" />}{project.eyebrow}</p>
  <h1 class:list={['t-display mt-4', { 'case-title': isEditorial }]} aria-label={isEditorial ? project.title : undefined}>
    {isEditorial ? (
      <span aria-hidden="true">
        <span class="case-title-brand">{titleBrand} </span>
        <span class="case-title-accent">{Array.from(titleAccent).map((letter, index) => (
          <span class="case-letter" style={`--letter:${index}`}>{letter}</span>
        ))}</span>
      </span>
    ) : project.title}
  </h1>
  <p class="t-lead mt-6 max-w-none">{project.description}</p>
  {isFinance && <p class="finance-privacy"><Icon name="lock" class="h-4 w-4" />{t(lang, 'v2.finance.private')}</p>}

  <div class="mt-8 flex flex-wrap gap-3">
    {demo && (
      <a href="#demo" class="btn btn-primary">{t(lang, 'v2.case.demo')}</a>
    )}
    {
      project.link && (
        <a href={project.link} target="_blank" rel="noopener noreferrer" class="btn btn-primary">
          {t(lang, 'v2.work.visit')}
          <Icon name="arrowUpRight" class="h-4 w-4" />
        </a>
      )
    }
    {projectRepos(project.github).map((repo) => (
      <a href={repo.href} target="_blank" rel="noopener noreferrer" class="btn btn-ghost">
        <Icon name="github" class="h-4 w-4" />{repo.label}
      </a>
    ))}
    {
      project.publication && (
        <a href={project.publication.href} target="_blank" rel="noopener noreferrer" class="btn btn-ghost">
          <Icon name="book" class="h-4 w-4" />
          {project.publication.label}
        </a>
      )
    }
  </div>
  </div>
  {isTranscriber && (
    <div class="case-signal reveal" aria-hidden="true">
      <div class="case-signal-head"><span>YT / TRANSCRIBER</span><span class="case-signal-status" /></div>
      <div class="case-wave">{wave.map((height, index) => <i style={`--bar:${height}%;--beat:${index % 7}`} />)}</div>
      <div class="case-signal-caption">{t(lang, 'v2.case.signal')}</div>
      <div class="case-signal-lines">
        {[0, 1, 2].map((line) => (
          <div style={`--row:${line}`}><span>0{line + 1}</span><i /><i /></div>
        ))}
      </div>
      <div class="case-signal-foot"><span>yt-dlp / whisper.cpp</span><span>DeepL</span></div>
    </div>
  )}
  {isMutation && (
    <div class="case-signal mutation-signal reveal" aria-hidden="true">
      <div class="case-signal-head"><span>{t(lang, 'v2.mutation.explorer')}</span><Icon name="dna" class="h-5 w-5" /></div>
      <div class="mutation-sequence">
        {Array.from('ACGTAGCTAGGCTACGATCGTACGATGCTAGCTACGTAGCTAGGCTAC').map((base, index) => (
          <span class:list={{ 'is-variant': [7, 20, 31, 40].includes(index) }} style={`--base:${index % 12}`}>{base}</span>
        ))}
      </div>
      <div class="mutation-variants">{['D614G', 'N501Y', 'E484K', 'L452R'].map((variant) => <span>{variant}</span>)}</div>
      <div class="mutation-axis"><i /><i /><i /><i /><i /></div>
      <div class="case-signal-foot"><span>URV / D3.js</span><span>{t(lang, 'v2.mutation.illustration')}</span></div>
    </div>
  )}
  {isFinance && (
    <div class="case-signal finance-signal reveal" aria-hidden="true">
      <div class="case-signal-head"><span>FINANCE // CORE</span><Icon name="lock" class="h-4 w-4" /></div>
      <p class="finance-signal-label">{t(lang, 'v2.finance.demo')}</p>
      <div class="finance-modules">
        <span><Icon name="wallet" class="h-5 w-5" />{t(lang, 'v2.finance.source')}</span>
        <span><Icon name="chart" class="h-5 w-5" />{t(lang, 'v2.finance.output')}</span>
      </div>
      <div class="finance-ledger">
        {[0, 1, 2].map((row) => <div><span>0{row + 1}</span><i style={`--row:${row}`} /><Icon name="check" class="h-3 w-3" /></div>)}
      </div>
      <div class="finance-holdings"><span>{t(lang, 'v2.finance.holdings')}</span><div><b>BTC</b><b>ETH</b><b>SOL</b></div></div>
      <div class="case-signal-foot"><span>{t(lang, 'v2.finance.providers')}</span><Icon name="shield" class="h-4 w-4" /></div>
    </div>
  )}
  </div>
  {isEditorial && (
    <>
      <ol class="case-pipeline" aria-label={t(lang, 'v2.case.flow')}>
        <li><span>01 / {t(lang, 'v2.case.input')}</span><strong>{t(lang, flowKeys[0])}</strong></li>
        <li><span>02 / {t(lang, 'v2.case.process')}</span><strong>{t(lang, flowKeys[1])}</strong></li>
        <li><span>03 / {t(lang, 'v2.case.output')}</span><strong>{t(lang, flowKeys[2])}</strong></li>
      </ol>
      <a href={isMutation ? '#case-overview' : '#case-problem'} class="case-explore">{t(lang, 'v2.case.explore')}<Icon name="arrowLeft" class="h-4 w-4 -rotate-90" /></a>
    </>
  )}
  </header>

  {project.caseStudy && (
    <>
      <section class:list={['mt-14', { 'case-section case-problem reveal': isEditorial }]} aria-labelledby="case-problem">
        <h2 id="case-problem" class="t-meta text-[color:var(--cyan)]"><span class="case-section-number" aria-hidden="true">01</span>{t(lang, 'v2.case.problem')}</h2>
        <p class="mt-5 leading-relaxed text-[color:var(--fg-2)]">{project.caseStudy.problem}</p>
      </section>

      {project.caseStudy.demo && <CaseDemo lang={lang} projectKey={projectKey} demo={project.caseStudy.demo} sectionNumber="02" />}

      <section class:list={['mt-12', { 'case-section reveal': isEditorial }]} aria-labelledby="case-decisions">
        <h2 id="case-decisions" class="t-meta text-[color:var(--cyan)]"><span class="case-section-number" aria-hidden="true">03</span>{t(lang, 'v2.case.decisions')}</h2>
        <div class="mt-5 grid gap-4 sm:grid-cols-2">
          {project.caseStudy.decisions.map((decision, index) => (
            <div class:list={[CARD, { 'case-decision': isEditorial }]}>
              {isEditorial && <span class="case-decision-index" aria-hidden="true">0{index + 1} /</span>}
              <h3 class="font-semibold text-[color:var(--fg)]">{decision.title}</h3>
              <p class="mt-3 text-sm leading-relaxed text-[color:var(--fg-2)]">{decision.body}</p>
            </div>
          ))}
        </div>
      </section>

      <section class:list={['mt-12', { 'case-section case-limits reveal': isEditorial }]} aria-labelledby="case-limits">
        <h2 id="case-limits" class="t-meta text-[color:var(--cyan)]"><span class="case-section-number" aria-hidden="true">04</span>{t(lang, 'v2.case.limits')}</h2>
        <ul class="mt-5 list-disc space-y-3 pl-5 leading-relaxed text-[color:var(--fg-2)]">
          {project.caseStudy.limits.map((limit) => <li>{limit}</li>)}
        </ul>
      </section>

      <section class:list={['mt-12', { 'case-section case-outcome reveal': isEditorial }]} aria-labelledby="case-outcome">
        <h2 id="case-outcome" class="t-meta text-[color:var(--cyan)]"><span class="case-section-number" aria-hidden="true">05</span>{t(lang, 'v2.case.outcome')}</h2>
        <p class="mt-5 leading-relaxed text-[color:var(--fg-2)]">{project.caseStudy.outcome}</p>
        <h3 class="mt-6 font-semibold text-[color:var(--fg)]">{t(lang, 'v2.case.verify')}</h3>
        <ol class="mt-3 list-decimal space-y-3 pl-5 leading-relaxed text-[color:var(--fg-2)]">
          {project.caseStudy.verification.map((step) => <li>{step}</li>)}
        </ol>
      </section>
    </>
  )}

  {
    project.deep && (
      <>
        <section id="case-overview" class:list={['mt-14', { 'case-section reveal': isEditorial }]}>
          <h2 class="t-meta text-[color:var(--cyan)]"><span class="case-section-number" aria-hidden="true">01</span>{t(lang, 'v2.case.overview')}</h2>
          <ul class:list={['mt-5 space-y-3', { 'mutation-overview': isMutation }]}>
            {project.deep.highlights.map((h, index) => (
              <li class="flex gap-3 leading-relaxed text-[color:var(--fg-2)]">
                {isMutation ? <span class="mutation-icon"><Icon name={researchIcons[index] ?? 'microscope'} class="h-5 w-5" /></span>
                  : <span class="mt-2.5 h-1.5 w-1.5 shrink-0 rounded-full bg-[color:var(--blue-bright)]" aria-hidden="true" />}
                {h}
              </li>
            ))}
          </ul>
        </section>
        {project.deep.demo && <CaseDemo lang={lang} projectKey={projectKey} demo={project.deep.demo} sectionNumber="02" />}

        <section class:list={['mt-12 grid gap-4 sm:grid-cols-2', { 'case-section reveal': isEditorial }]}>
          {isMutation && <h2 class="t-meta text-[color:var(--cyan)] sm:col-span-2"><span class="case-section-number" aria-hidden="true">{project.deep.demo ? '03' : '02'}</span>{t(lang, 'v2.mutation.context')}</h2>}
          <div class={CARD}>
            <p class={CARD_LABEL}>{project.deep.partnerLabel}</p>
            <p class="mt-2 font-semibold text-[color:var(--fg)]">{project.deep.partnerName}</p>
            <p class="mt-2 text-sm leading-relaxed text-[color:var(--fg-2)]">{project.deep.partnerDescription}</p>
          </div>
          <div class="flex flex-col gap-4">
            <div class={CARD}>
              <p class={CARD_LABEL}>{project.deep.focusLabel}</p>
              <p class="mt-2 text-sm text-[color:var(--fg-2)]">{project.deep.focusText}</p>
            </div>
            <div class={CARD}>
              <p class={CARD_LABEL}>{project.deep.intersectionLabel}</p>
              <p class="mt-2 text-sm text-[color:var(--fg-2)]">{project.deep.intersectionText}</p>
            </div>
          </div>
        </section>
      </>
    )
  }
  {isMutation && project.publication && (
    <section class="case-publication reveal" aria-labelledby="case-publication">
      <span class="case-publication-icon"><Icon name="book" class="h-8 w-8" /></span>
      <div>
        <h2 id="case-publication">{t(lang, 'v2.mutation.publication')}</h2>
        <p>{project.publication.label}</p>
        <a href={project.publication.href} target="_blank" rel="noopener noreferrer" class="btn btn-ghost">{t(lang, 'v2.work.paper')}<Icon name="external" class="h-4 w-4" /></a>
      </div>
    </section>
  )}

  <section class:list={['mt-12', { 'case-section reveal': isEditorial }]}>
    <h2 class="t-meta text-[color:var(--cyan)]">{t(lang, 'v2.case.stack')}</h2>
    <ul class="mt-4 flex flex-wrap gap-2">
      {[...project.tech, ...project.domains].map((tech) => (
        <li><TechChip tag={tech} lang={lang} /></li>
      ))}
    </ul>
  </section>

  {
    role && (
      <section class="mt-12 border-t border-[color:var(--line-soft)] pt-8">
        <p class="text-sm text-[color:var(--fg-2)]">
          <span class="font-semibold text-[color:var(--fg)]">{role.role}</span>
          <span class="text-[color:var(--fg-3)]"> · {role.company} · {formatPeriod(role.start, role.end, lang)}</span>
        </p>
      </section>
    )
  }
  <aside class:list={['mt-12 rounded-xl border border-[color:var(--line)] p-5', { 'case-contact reveal': isEditorial }]}>
    <p class="font-semibold text-[color:var(--fg)]">{t(lang, 'v2.case.contact')}</p>
    <a href={localePath('/#contact', lang)} class="btn btn-ghost mt-4">{t(lang, 'v2.case.contactCta')}</a>
  </aside>
</article>

<!--
  Only an origin that is on the list is accepted: the value comes from the URL,
  so it is never written into the link as-is.
-->
<script is:inline define:vars={{ targets: BACK_TARGETS }}>
  const from = new URLSearchParams(window.location.search).get('from')
  const back = document.getElementById('case-back')
  if (back && from && Object.hasOwn(targets, from)) back.href = targets[from]
</script>

<script>
  import { revealOnScroll } from '../scripts/reveal'

  if (document.querySelector('.editorial-case')) {
    revealOnScroll({
      reduce: window.matchMedia('(prefers-reduced-motion: reduce)').matches,
      rootMargin: '0px 0px -8% 0px',
      threshold: 0.05,
    })
  }
</script>
