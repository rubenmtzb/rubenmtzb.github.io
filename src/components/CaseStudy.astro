---
import Icon from './Icon.astro'
import TechChip from './v2/TechChip.astro'
import { getExperience, getProjects, formatPeriod, localePath } from '../lib/content'
import { t, type Lang } from '../i18n/ui'

/**
 * Ficha de proyecto en profundidad.
 *
 * Comparte hoja de estilos con la V2, así que usa su vocabulario:
 * los tokens --ink/--line/--fg y las clases tipográficas t-*. Las chips
 * de stack son el mismo componente que en la portada, no una píldora
 * paralela que pudiera divergir de color o de enlace.
 */
interface Props { lang: Lang; projectKey: string }
const { lang, projectKey } = Astro.props

const project = (await getProjects(lang)).find((p) => p.key === projectKey)
if (!project) throw new Error(`Ficha: no existe el proyecto "${projectKey}"`)

/** El puesto desde el que se construyó, si lo hubo. */
const role = (await getExperience(lang)).find((e) => e.company === project.deep?.partnerName)
/**
 * Vuelta a la portada.
 *
 * La ficha se enlaza desde dos sitios —el carrusel destacado y la rejilla— y
 * cada uno se anuncia con `?from=`. Ese parámetro no se puede leer al generar
 * la página: el sitio es estático y la ficha se renderiza una sola vez, así que
 * el enlace de build apunta al área de trayectoria, que es correcta venga de
 * donde venga. El script de abajo lo afina en el navegador, donde el parámetro
 * sí existe; sin JavaScript el enlace sigue llevando a su sitio.
 */
const backPath = localePath('/#work', lang)

/** Los dos orígenes admitidos, ya resueltos al idioma de la página. */
const BACK_TARGETS = {
  'project-carousel': localePath('/#project-carousel', lang),
  'project-deck': localePath('/#project-deck', lang),
}

const CARD = 'rounded-xl border border-[color:var(--line)] bg-[color:var(--ink-800)] p-5'
const CARD_LABEL = 't-meta text-[0.62rem] text-[color:var(--fg-3)]'
---

<article class="mx-auto w-full max-w-3xl px-5 pb-24 pt-28 sm:px-8 sm:pt-36">
  <a id="case-back" href={backPath} class="inline-flex items-center gap-2 text-sm text-[color:var(--fg-3)] transition hover:text-[color:var(--fg)]">
    <Icon name="arrowLeft" class="h-4 w-4" />
    {t(lang, 'v2.case.back')}
  </a>

  <p class="t-meta mt-8 text-[color:var(--blue-bright)]">{project.eyebrow}</p>
  <h1 class="t-display mt-4">{project.title}</h1>
  <p class="t-lead mt-6 max-w-none">{project.description}</p>

  <div class="mt-8 flex flex-wrap gap-3">
    {
      project.link && (
        <a href={project.link} target="_blank" rel="noopener noreferrer" class="btn btn-primary">
          {t(lang, 'v2.work.visit')}
          <Icon name="arrowUpRight" class="h-4 w-4" />
        </a>
      )
    }
    {
      project.publication && (
        <a href={project.publication.href} target="_blank" rel="noopener noreferrer" class="btn btn-ghost">
          <Icon name="book" class="h-4 w-4" />
          {project.publication.label}
        </a>
      )
    }
  </div>

  {
    project.deep && (
      <>
        <section class="mt-14">
          <h2 class="t-meta text-[color:var(--cyan)]">{t(lang, 'v2.case.overview')}</h2>
          <ul class="mt-5 space-y-3">
            {project.deep.highlights.map((h) => (
              <li class="flex gap-3 leading-relaxed text-[color:var(--fg-2)]">
                <span class="mt-2.5 h-1.5 w-1.5 shrink-0 rounded-full bg-[color:var(--blue-bright)]" aria-hidden="true" />
                {h}
              </li>
            ))}
          </ul>
        </section>

        <section class="mt-12 grid gap-4 sm:grid-cols-2">
          <div class={CARD}>
            <p class={CARD_LABEL}>{project.deep.partnerLabel}</p>
            <p class="mt-2 font-semibold text-[color:var(--fg)]">{project.deep.partnerName}</p>
            <p class="mt-2 text-sm leading-relaxed text-[color:var(--fg-2)]">{project.deep.partnerDescription}</p>
          </div>
          <div class="flex flex-col gap-4">
            <div class={CARD}>
              <p class={CARD_LABEL}>{project.deep.focusLabel}</p>
              <p class="mt-2 text-sm text-[color:var(--fg-2)]">{project.deep.focusText}</p>
            </div>
            <div class={CARD}>
              <p class={CARD_LABEL}>{project.deep.intersectionLabel}</p>
              <p class="mt-2 text-sm text-[color:var(--fg-2)]">{project.deep.intersectionText}</p>
            </div>
          </div>
        </section>
      </>
    )
  }

  <section class="mt-12">
    <h2 class="t-meta text-[color:var(--cyan)]">{t(lang, 'v2.case.stack')}</h2>
    <ul class="mt-4 flex flex-wrap gap-2">
      {[...project.tech, ...project.domains].map((tech) => (
        <li><TechChip tag={tech} lang={lang} /></li>
      ))}
    </ul>
  </section>

  {
    role && (
      <section class="mt-12 border-t border-[color:var(--line-soft)] pt-8">
        <p class="text-sm text-[color:var(--fg-2)]">
          <span class="font-semibold text-[color:var(--fg)]">{role.role}</span>
          <span class="text-[color:var(--fg-3)]"> · {role.company} · {formatPeriod(role.start, role.end, lang)}</span>
        </p>
      </section>
    )
  }
</article>

<!--
  Solo se acepta un origen que esté en la lista: el valor viene de la URL, así
  que nunca se escribe en el enlace tal cual.
-->
<script is:inline define:vars={{ targets: BACK_TARGETS }}>
  const from = new URLSearchParams(window.location.search).get('from')
  const back = document.getElementById('case-back')
  if (back && from && Object.hasOwn(targets, from)) back.href = targets[from]
</script>
