---
import { abs, buildJsonLd, getCluster, getPage } from '../lib/content'
import { LOCALE_TAGS } from '../site.config'
import type { Lang } from '../i18n/ui'

interface Props {
  pageKey: string
  lang: Lang
  pageType?: 'WebPage' | 'ProfilePage'
}

const { pageKey, lang, pageType = 'WebPage' } = Astro.props

const page = await getPage(pageKey, lang)
const cluster = await getCluster(pageKey)
const canonical = abs(page.path)

/**
 * Cluster invariant: every member emits the SAME hreflang set, includes itself
 * and declares x-default. It is generated from the data, so it cannot diverge
 * between pages of the same cluster.
 */
const alternates = cluster.alternates.map((a) => ({ lang: a.lang, href: abs(a.path) }))
const xDefault = abs(cluster.xDefault)

const jsonLd = await buildJsonLd({
  lang,
  pageUrl: canonical,
  pageType,
  pageName: page.title,
  pageDescription: page.description,
})

const ogLocale = LOCALE_TAGS[lang]

/*
 * `profile` describes a person, so only the pages that are about Rubén qualify.
 * The case study and the CV used to declare the same as the home page, and a
 * case study is nobody's profile.
 */
const ogType = pageType === 'ProfilePage' ? 'profile' : 'website'

/*
 * The `<` is escaped. In an inline block, a `</script>` inside any string of the
 * content — the dash in a "C# <-> Java" is enough — would close the tag early
 * and break the JSON-LD. `\u003c` is a valid JSON escape, so what a search
 * engine reads is exactly the same data.
 */
const structuredData = JSON.stringify(jsonLd).replaceAll('<', '\\u003c')
---

<meta charset="utf-8" />
<meta name="viewport" content="width=device-width, initial-scale=1" />

<title>{page.title}</title>
<meta name="description" content={page.description} />
<meta name="author" content="Rubén Martínez Bernabe" />
<meta name="robots" content={page.indexable ? 'index, follow' : 'noindex, follow'} />

<link rel="canonical" href={canonical} />
{
  /*
   * hreflang on indexable pages only. Google ignores it on noindex pages, and
   * declaring it towards a non-indexable URL is a configuration error: the
   * preview and an eventual noindex V1 do not emit it.
   */
  page.indexable && (
    <>
      {alternates.map((a) => <link rel="alternate" hreflang={a.lang} href={a.href} />)}
      <link rel="alternate" hreflang="x-default" href={xDefault} />
    </>
  )
}

<meta property="og:type" content={ogType} />
<meta property="og:site_name" content="rubenitx.me" />
<meta property="og:locale" content={ogLocale} />
<meta property="og:url" content={canonical} />
<meta property="og:title" content={page.title} />
<meta property="og:description" content={page.description} />
<meta property="og:image" content={abs(page.ogImage)} />
<meta property="og:image:alt" content={page.ogImageAlt} />
{page.ogImageWidth && <meta property="og:image:width" content={String(page.ogImageWidth)} />}
{page.ogImageHeight && <meta property="og:image:height" content={String(page.ogImageHeight)} />}

<meta name="twitter:card" content="summary_large_image" />
<meta name="twitter:url" content={canonical} />
<meta name="twitter:title" content={page.title} />
<meta name="twitter:description" content={page.description} />
<meta name="twitter:image" content={abs(page.ogImage)} />
<meta name="twitter:image:alt" content={page.ogImageAlt} />

<!--
  The vector icon weighs 883 bytes and works at any size; the PNG stays as a
  fallback for browsers that do not accept SVG in the tab. Both slots used to
  point at the full portrait: 24 kB on every page to paint sixteen square
  pixels.
-->
<link rel="icon" type="image/svg+xml" href="/favicon.svg" />
<link rel="icon" type="image/png" sizes="192x192" href="/icon-192.png" />
<link rel="apple-touch-icon" href="/icon-192.png" />
<link rel="manifest" href="/manifest.json" />
<meta name="theme-color" content="#030712" />

<script type="application/ld+json" set:html={structuredData} is:inline />
