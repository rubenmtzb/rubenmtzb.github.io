---
import Icon from '../Icon.astro'
import {
  abs, casePath, cvPdfPath, formatPeriod, formatYears, getAlternate,
  getEducation, getExperience, getProfile, getProjects, homePath,
  projectRepos, tenureMonths, withYears,
} from '../../lib/content'
import { SITE } from '../../site.config'
import { t, type Lang } from '../../i18n/ui'

interface Props { lang: Lang }
const { lang } = Astro.props
const [profile, allExperience, allEducation, allProjects, other] = await Promise.all([
  getProfile(lang), getExperience(lang), getEducation(lang), getProjects(lang), getAlternate('cv', lang),
])
const experience = allExperience.flatMap(item => {
  if (!item.cv) return []
  const reference = item.cv.project ? casePath(item.cv.project, lang) : null
  if (item.cv.project && !reference) throw new Error(`CV: missing case study for ${item.cv.project}`)
  return [{ ...item, cv: item.cv, reference }]
})
const projects = allProjects.filter(project => project.inCv).map(project => {
  if (!project.cvSummary) throw new Error(`CV: missing concise summary for ${project.key}`)
  return { ...project, cvSummary: project.cvSummary, caseHref: casePath(project.key, lang) }
})
const education = allEducation.filter(item => ['uoc', 'daw'].includes(item.key))
const currentRole = allExperience.find(item => item.end === null)
if (!currentRole) throw new Error('CV: a current technical role is required for the core stack')
const coreStack = currentRole.tech
const years = formatYears(tenureMonths(allExperience), lang)
const shortUrl = (url: string) => url.replace(/^https?:\/\/(www\.)?/, '').replace(/\/$/, '')
---

<div class="cv-workspace">
  <nav class="cv-toolbar no-print" aria-label={t(lang, 'cv.actions')}>
    <a href={homePath(lang)}><Icon name="arrowLeft" />{t(lang, 'cv.back')}</a>
    <div class="cv-toolbar-actions">
      <a href={other.path} hreflang={other.lang} rel="alternate" data-language-switch aria-label={t(lang, 'cv.langSwitch')}>
        <Icon name="globe" />{t(lang, 'nav.langNext')}
      </a>
      <a class="cv-download" href={cvPdfPath(lang)} download>
        <Icon name="download" />{t(lang, 'cv.print')}
      </a>
    </div>
  </nav>
  <p class="cv-format no-print">{t(lang, 'cv.format')}</p>

  <article class="cv-document cv-sheet" data-cv-sheet="1" aria-labelledby="cv-name">
    <header class="cv-header">
      <h1 id="cv-name">{profile.name}</h1>
      <div class="cv-heading-meta">
        <p class="cv-role">{profile.jobTitle}</p>
        <p class="cv-location">{profile.locality}, {profile.region}</p>
      </div>
      <address class="cv-contact" aria-label={t(lang, 'cv.contact')}>
        <a href={`mailto:${profile.email}`}>{profile.email}</a>
        <a href={abs(homePath(lang))} aria-label={`${t(lang, 'cv.portfolio')}: ${shortUrl(SITE)}`}>{shortUrl(SITE)}</a>
        {profile.socials.map(social => <a href={social.href}>{shortUrl(social.href)}</a>)}
      </address>
      <p class="cv-summary">{withYears(profile.cvOnly.summary, years)}</p>
    </header>

    <section class="cv-section cv-skills" aria-labelledby="cv-skills-title">
      <h2 id="cv-skills-title">{t(lang, 'cv.skills')}</h2>
      <p>{coreStack.join(' · ')}</p>
    </section>

    <section class="cv-section cv-experience" aria-labelledby="cv-experience-title">
      <h2 id="cv-experience-title">{t(lang, 'cv.experience')}</h2>
      <ol class="cv-entries">
        {experience.map(item => (
          <li class="cv-entry" data-cv-experience={item.key}>
            <div class="cv-entry-heading">
              <h3>{item.company}</h3>
              <p class="cv-date">{formatPeriod(item.start, item.end, lang)}</p>
            </div>
            <p class="cv-entry-role">{item.role}</p>
            <ul class="cv-bullets">{item.cv.bullets.map(bullet => <li>{bullet}</li>)}</ul>
            {item.reference && <p class="cv-evidence"><a href={abs(item.reference)}>{t(lang, 'cv.caseStudy')}</a></p>}
          </li>
        ))}
      </ol>
    </section>

    <section class="cv-section cv-projects" aria-labelledby="cv-projects-title">
      <h2 id="cv-projects-title">{t(lang, 'cv.projects')}</h2>
      <ul class="cv-entries">
        {projects.map(project => (
          <li class="cv-entry" data-cv-project={project.key}>
            <div class="cv-entry-heading">
              <h3>{project.title}</h3>
              {project.badge === 'private' && <span class="cv-private">{t(lang, 'work.badge.private')}</span>}
            </div>
            <p>{project.cvSummary}</p>
            <div class="cv-project-links">
              {project.caseHref && <a href={abs(project.caseHref)}>{t(lang, 'cv.caseStudy')}</a>}
              {project.link && <a href={project.link}>{shortUrl(project.link)}</a>}
              {projectRepos(project.github).map(repo => <a href={repo.href}>{repo.label === 'GitHub' ? 'GitHub' : `GitHub ${repo.label}`}</a>)}
            </div>
          </li>
        ))}
      </ul>
    </section>

    <section class="cv-section cv-education" aria-labelledby="cv-education-title">
      <h2 id="cv-education-title">{t(lang, 'cv.education')}</h2>
      <ul class="cv-entries">
        {education.map(item => (
          <li class="cv-entry">
            <h3>{item.title}</h3>
            <p>{item.institution} · {item.periodLabel}{item.inProgress && ` · ${t(lang, 'background.inProgress')}`}
              {item.credential && <> · <a href={item.credential.verifyUrl}>{t(lang, 'background.verify')}</a></>}
            </p>
          </li>
        ))}
      </ul>
    </section>

    <footer class="cv-languages">
      <h2>{t(lang, 'cv.languages')}</h2>
      <ul>{profile.languages.map(language => <li>{language.name}</li>)}</ul>
    </footer>
  </article>
</div>
