---
/**
 * Precarga de las dos fuentes latinas.
 *
 * Los @font-face viven dentro del CSS, así que el navegador no descubre el
 * fichero hasta haber descargado y analizado la hoja entera: con la conexión
 * ya libre, el titular se pinta antes con la fuente correcta en lugar de
 * pasar por el respaldo del sistema.
 *
 * Solo el subconjunto latino. Los de cirílico, griego y vietnamita siguen
 * gobernados por su `unicode-range`: el navegador solo los pide si el texto
 * los necesita, y precargarlos sería descargar 40 kB que nadie usa.
 */
import archivoLatin from '@fontsource-variable/archivo/files/archivo-latin-wght-normal.woff2?url'
import monoLatin from '@fontsource-variable/jetbrains-mono/files/jetbrains-mono-latin-wght-normal.woff2?url'

interface Props {
  /** La V1 es solo monoespaciada: no carga Archivo, así que no la precarga. */
  display?: boolean
}
const { display = true } = Astro.props
---

{display && <link rel="preload" href={archivoLatin} as="font" type="font/woff2" crossorigin />}
<link rel="preload" href={monoLatin} as="font" type="font/woff2" crossorigin />
