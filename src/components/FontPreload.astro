---
/**
 * Preload of the two Latin fonts.
 *
 * The @font-face rules live inside the CSS, so the browser does not discover the
 * file until it has downloaded and parsed the whole sheet: with the connection
 * already free, the headline paints sooner in the right font instead of going
 * through the system fallback.
 *
 * The Latin subset only. The Cyrillic, Greek and Vietnamese ones stay governed
 * by their `unicode-range`: the browser only asks for them if the text needs
 * them, and preloading them would mean downloading 40 kB nobody uses.
 */
import archivoLatin from '@fontsource-variable/archivo/files/archivo-latin-wght-normal.woff2?url'
import monoLatin from '@fontsource-variable/jetbrains-mono/files/jetbrains-mono-latin-wght-normal.woff2?url'

interface Props {
  /** The V1 is monospace only: it does not load Archivo, so it does not preload it. */
  display?: boolean
}
const { display = true } = Astro.props
---

{display && <link rel="preload" href={archivoLatin} as="font" type="font/woff2" crossorigin />}
<link rel="preload" href={monoLatin} as="font" type="font/woff2" crossorigin />
