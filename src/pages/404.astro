---
/**
 * 404 personalizado. GitHub Pages sirve /404.html para cualquier ruta
 * inexistente: es la única pieza de routing que el hosting sí ofrece.
 * No entra en el sitemap y va noindex.
 */
import Icon from '../components/Icon.astro'
import '../styles/v2.css'
---
<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>404 — Rubén Martínez Bernabe</title>
    <meta name="robots" content="noindex, follow" />
    <link rel="icon" type="image/png" href="/avatar.png" />
  </head>
  <body>
    <main class="mx-auto flex min-h-dvh max-w-2xl flex-col justify-center px-6">
      <p class="v2-eyebrow">404</p>
      <h1 class="v2-display mt-4 text-[clamp(2rem,6vw,3.4rem)]">This route does not resolve.</h1>
      <p class="v2-lede mt-5">
        The page you were looking for is not here. It may have moved, or the link may be out of date.
      </p>
      <p class="mt-8 flex flex-wrap gap-3">
        <a href="/" class="inline-flex items-center gap-2 rounded-lg bg-[#00ff88] px-5 py-3 text-sm font-semibold text-[#06120c]">
          <Icon name="arrowLeft" class="h-4 w-4" />Home
        </a>
        <a href="/cv/" class="inline-flex items-center gap-2 rounded-lg border border-[var(--v2-line)] px-5 py-3 text-sm font-semibold">CV</a>
        <a href="/v1/" class="inline-flex items-center gap-2 rounded-lg border border-[var(--v2-line)] px-5 py-3 text-sm font-semibold">Documentary version</a>
      </p>
    </main>
  </body>
</html>
