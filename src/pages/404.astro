---
/**
 * Custom 404. GitHub Pages serves /404.html for any route that does not exist:
 * it is the one piece of routing the hosting does offer.
 *
 * It is not a URL of the site, so it is absent from the `pages` collection, it
 * stays out of the sitemap and it emits no hreflang. Since the hosting serves
 * the same file for the routes of both languages, the HTML starts from the
 * default language and adapts the copy when the requested URL belongs to the
 * Spanish prefix.
 */
import BaseLayout from '../layouts/BaseLayout.astro'
import Icon from '../components/Icon.astro'
import { DEFAULT_LANG } from '../i18n/ui'
import '../styles/v2.css'
---

<BaseLayout lang={DEFAULT_LANG}>
  <Fragment slot="head">
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>404 — Rubén Martínez Bernabe</title>
    <meta name="robots" content="noindex, follow" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="icon" type="image/png" sizes="192x192" href="/icon-192.png" />
  </Fragment>

  <main id="main" class="mx-auto flex min-h-dvh max-w-2xl flex-col justify-center px-6">
    <p class="t-index">404</p>
    <h1 id="not-found-title" class="t-display mt-4">This route does not resolve.</h1>
    <p id="not-found-copy" class="t-lead mt-5 max-w-none">
      The page you were looking for is not here. It may have moved, or the link may be out of date.
    </p>
    <p class="mt-8 flex flex-wrap gap-3">
      <a id="not-found-home" href="/" class="btn btn-primary">
        <Icon name="arrowLeft" class="h-4 w-4" /><span>Home</span>
      </a>
      <a id="not-found-cv" href="/cv/" class="btn btn-ghost">CV</a>
      <a id="not-found-v1" href="/v1/" class="btn btn-ghost">Documentary version</a>
    </p>
  </main>

  <!--
    The hosting serves this very file for any route that does not exist, in both
    languages, so the translation is the one thing that cannot be resolved at
    build time. Each touch-up is independent: if an element goes missing
    tomorrow, that one stays untranslated instead of aborting the rest halfway.
  -->
  <script is:inline>
    if (location.pathname === '/es' || location.pathname.startsWith('/es/')) {
      const write = (selector, text) => {
        const node = document.querySelector(selector)
        if (node) node.textContent = text
      }
      const point = (selector, href) => {
        const node = document.querySelector(selector)
        if (node) node.href = href
      }
      document.documentElement.lang = 'es'
      write('.skip-link', 'Saltar al contenido')
      write('#not-found-title', 'Esta ruta no existe.')
      write('#not-found-copy', 'La página que buscabas no está aquí. Puede que se haya movido o que el enlace ya no esté actualizado.')
      write('#not-found-home span', 'Inicio')
      point('#not-found-home', '/es/')
      point('#not-found-cv', '/es/cv/')
      write('#not-found-v1', 'Versión documental')
      point('#not-found-v1', '/v1/es/')
    }
  </script>
</BaseLayout>
