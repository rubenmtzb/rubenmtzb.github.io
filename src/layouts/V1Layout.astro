---
import BaseLayout from './BaseLayout.astro'
import Nav from '../components/v1/Nav.astro'
import Hero from '../components/v1/Hero.astro'
import About from '../components/v1/About.astro'
import Work from '../components/v1/Work.astro'
import Background from '../components/v1/Background.astro'
import Contact from '../components/v1/Contact.astro'
import Footer from '../components/v1/Footer.astro'
import type { Lang } from '../i18n/ui'

interface Props { lang: Lang }
const { lang } = Astro.props
---

<BaseLayout pageKey="home" lang={lang} pageType="ProfilePage" bodyClass="relative min-h-screen w-full overflow-x-hidden">
  <div
    class="grid-move pointer-events-none fixed inset-0 z-0 opacity-[0.06]"
    style="background-image:linear-gradient(rgba(0,255,136,.12) 1px,transparent 1px),linear-gradient(90deg,rgba(0,255,136,.12) 1px,transparent 1px);background-size:40px 40px"
    aria-hidden="true"
  >
  </div>
  <div class="pointer-events-none fixed inset-0 z-0 bg-[radial-gradient(ellipse_80%_55%_at_50%_-10%,rgba(0,255,136,0.08),transparent)]" aria-hidden="true"></div>

  <Nav lang={lang} pageKey="home" />

  <main id="main" class="relative z-10">
    <Hero lang={lang} />
    <div class="h-px bg-gradient-to-r from-transparent via-green-500/15 to-transparent" aria-hidden="true"></div>
    <About lang={lang} />
    <Work lang={lang} />
    <Background lang={lang} />
    <Contact lang={lang} />
  </main>

  <Footer lang={lang} />

  <script>
    import '../scripts/enhance'
  </script>
</BaseLayout>
