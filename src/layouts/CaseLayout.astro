---
import Seo from '../components/Seo.astro'
import CaseStudy from '../components/CaseStudy.astro'
import Footer from '../components/v2/Footer.astro'
import Icon from '../components/Icon.astro'
import { getCluster } from '../lib/content'
import { t, type Lang } from '../i18n/ui'
import '../styles/v2.css'

interface Props { lang: Lang; pageKey: string; projectKey: string }
const { lang, pageKey, projectKey } = Astro.props

const cluster = await getCluster(pageKey)
const other = cluster.alternates.find((a) => a.lang !== lang)!
const homePath = lang === 'es' ? '/es/' : '/'
---
<!doctype html>
<html lang={lang}>
  <head>
    <Seo pageKey={pageKey} lang={lang} pageType="WebPage" />
    <script is:inline>document.documentElement.classList.add('js')</script>
  </head>
  <body>
    <a class="skip-link" href="#main">{t(lang, 'nav.skip')}</a>
    <header class="fixed inset-x-0 top-0 z-50">
      <nav aria-label="Principal" class="mx-auto flex w-full max-w-3xl items-center justify-between px-5 py-4 sm:px-8">
        <a href={homePath} class="text-sm font-bold tracking-[0.3em] text-[var(--v2-fg)]">RMB</a>
        <a href={other.path} hreflang={other.lang} rel="alternate"
           class="inline-flex items-center gap-1.5 text-sm text-[var(--v2-fg-dim)] transition hover:text-[var(--v2-fg)]"
           aria-label={t(lang, 'nav.langSwitch')}>
          <Icon name="globe" class="h-3.5 w-3.5" />{t(lang, 'nav.langNext')}
        </a>
      </nav>
    </header>
    <main id="main"><CaseStudy lang={lang} projectKey={projectKey} /></main>
    <Footer lang={lang} />
  </body>
</html>
