---
import BaseLayout from './BaseLayout.astro'
import CaseStudy from '../components/CaseStudy.astro'
import Footer from '../components/v2/Footer.astro'
import Icon from '../components/Icon.astro'
import { getAlternate, homePath } from '../lib/content'
import { t, type Lang } from '../i18n/ui'
import '../styles/v2.css'

interface Props { lang: Lang; pageKey: string; projectKey: string }
const { lang, pageKey, projectKey } = Astro.props

const other = await getAlternate(pageKey, lang)
---

<BaseLayout lang={lang} pageKey={pageKey}>
  <header class="fixed inset-x-0 top-0 z-50 editorial-case-nav">
    <nav aria-label={t(lang, 'a11y.mainNav')} class="mx-auto flex w-full max-w-3xl items-center justify-between px-5 py-4 sm:px-8">
      <a href={homePath(lang)} class="text-sm font-bold tracking-[0.3em] text-[color:var(--fg)]">RMB</a>
      <a href={other.path} hreflang={other.lang} rel="alternate" data-language-switch
         class="inline-flex items-center gap-1.5 text-sm text-[color:var(--fg-3)] transition hover:text-[color:var(--fg)]"
         aria-label={t(lang, 'nav.langSwitch')}>
        <Icon name="globe" class="h-3.5 w-3.5" />{t(lang, 'nav.langNext')}
      </a>
    </nav>
  </header>
  <main id="main"><CaseStudy lang={lang} projectKey={projectKey} /></main>
  <Footer lang={lang} topId="main" />
  <script>
    import { initLanguageSwitch } from '../scripts/language-switch'
    initLanguageSwitch()
  </script>
</BaseLayout>
