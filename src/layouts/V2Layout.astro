---
import BaseLayout from './BaseLayout.astro'
import Nav from '../components/v2/Nav.astro'
import Identity from '../components/v2/Identity.astro'
import Work from '../components/v2/Work.astro'
import About from '../components/v2/About.astro'
import OutsideTheCode from '../components/v2/OutsideTheCode.astro'
import Contact from '../components/v2/Contact.astro'
import Footer from '../components/v2/Footer.astro'
import { cvPath } from '../lib/content'
import type { Lang } from '../i18n/ui'
import '../styles/v2.css'

interface Props { lang: Lang; pageKey: string }
const { lang, pageKey } = Astro.props
const cv = cvPath(lang)
---

<BaseLayout lang={lang} pageKey={pageKey} pageType="ProfilePage">
  <link slot="head-extra" rel="preload" href="/avatar.png" as="image" />
  <Nav lang={lang} pageKey={pageKey} />
  <main id="main">
    <Identity lang={lang} cvPath={cv} />
    <Work lang={lang} />
    <About lang={lang} />
    <OutsideTheCode lang={lang} />
    <Contact lang={lang} cvPath={cv} />
  </main>
  <Footer lang={lang} />
  <script>import '../scripts/v2'</script>
</BaseLayout>
